#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Блок = Параметры.Блок;
	ЗаполнитьТаблицуТеговБлока();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьHTML();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Справочник.Теги.Изменение" Тогда
		
		Для Каждого Строка Из ТаблицаТегиБлока Цикл
			Если Строка.Тег = Параметр.Тег Тогда
				Строка.Представление = Параметр.Представление;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ОбновитьHTML();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПоискаОчистка(Элемент, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	СтрокаПоискаТеги = ""; 
	ОбновитьHTML();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	СтрокаПоискаТеги = Текст;
	СтандартнаяОбработка = Ложь;
	ОбновитьHTML();  
	
КонецПроцедуры 

&НаКлиенте
Процедура ТегиПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	ЭлементКлик = ДанныеСобытия.Element;
	
	Если ЭлементКлик.tagName = "BUTTON" И СтрНайти(ЭлементКлик.className, "btn-edit") > 0 Тогда
		ГУИД = ЭлементКлик.id;
		Ссылка = ПолеHTMLПриНажатииНаСервере(ГУИД);
		
		ПараметрыФормы = Новый Структура("Ключ", Ссылка, Истина);
		ОткрытьФорму("Справочник.Теги.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
		Возврат;
		
	ИначеЕсли ЭлементКлик.tagName = "BUTTON" Тогда
		ГУИД = ЭлементКлик.id;
		Ссылка = ПолеHTMLПриНажатииНаСервере(ГУИД);
		
		Для Каждого Строка Из ТаблицаТегиБлока Цикл
			Если Строка.Тег = Ссылка Тогда
				ТаблицаТегиБлока.Удалить(ТаблицаТегиБлока.Индекс(Строка));
				ОбновитьHTML();
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ЭлементКлик.tagName = "A" Тогда
		
		ГУИД = ЭлементКлик.id;
		Ссылка = ПолеHTMLПриНажатииНаСервере(ГУИД);
		
		Для Каждого Строка Из ТаблицаТегиБлока Цикл
			Если Строка.Тег = Ссылка Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
				
		Наименование = СокрЛП(ЭлементКлик.textContent);
		
		НоваяСтрока = ТаблицаТегиБлока.Добавить();
		НоваяСтрока.Тег = Ссылка;
		НоваяСтрока.Представление = Наименование; 
		
		ОбновитьHTML();
		
	ИначеЕсли ЭлементКлик.tagName = "svg" ИЛИ ЭлементКлик.tagName = "path" Тогда
		
		Родитель = ЭлементКлик.parentElement;
		Пока Родитель <> Неопределено И Родитель.tagName <> "BUTTON" Цикл
			Родитель = Родитель.parentElement;
		КонецЦикла;
		
		Если Родитель <> Неопределено И Родитель.tagName = "BUTTON" Тогда
			
			Если СтрНайти(Родитель.className, "btn-edit") > 0 Тогда
				ГУИД = Родитель.id;
				Ссылка = ПолеHTMLПриНажатииНаСервере(ГУИД);
				
				ПараметрыФормы = Новый Структура("Ключ", Ссылка, Истина);
				ОткрытьФорму("Справочник.Теги.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
				Возврат;
			Иначе
				ГУИД = Родитель.id;
				Ссылка = ПолеHTMLПриНажатииНаСервере(ГУИД);
				
				Для Каждого Строка Из ТаблицаТегиБлока Цикл
					Если Строка.Тег = Ссылка Тогда
						ТаблицаТегиБлока.Удалить(ТаблицаТегиБлока.Индекс(Строка));
						ОбновитьHTML();
						Возврат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьТег(Команда)   

	ПараметрыФормы = Новый Структура("ТекстЗаполнения", СтрокаПоискаТеги);
	ОткрытьФорму("Справочник.Теги.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьТеги(Команда) 
	
	МассивТеги = Новый Массив;
	Для Каждого Строка Из ТаблицаТегиБлока Цикл
		МассивТеги.Добавить(Строка.Тег);
	КонецЦикла;
	
	ОповеститьОВыборе(МассивТеги);
	
КонецПроцедуры 

&НаКлиенте
Процедура Заполнить(Команда)
	
	СтрокаПоискаТеги = "";
	ТаблицаТегиБлока.Очистить();
	ОбновитьHTML();
	
КонецПроцедуры


&НаКлиенте
Процедура Поиск(Команда)
	
	ОбновитьHTML(); 
	 
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуТеговБлока()
	
	ТаблицаТегиБлока.Очистить();
	
	Если Параметры.Блок = Неопределено Или Параметры.Блок.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТегиПоБлокам.Тег КАК Тег,
	|	ТегиПоБлокам.Тег.Наименование КАК Представление
	|ИЗ
	|	РегистрСведений.ТегиПоБлокам КАК ТегиПоБлокам
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Теги КАК Теги
	|		ПО ТегиПоБлокам.Тег = Теги.Ссылка
	|ГДЕ
	|	ТегиПоБлокам.Блок = &Блок";
	
	Запрос.УстановитьПараметр("Блок", Параметры.Блок);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаТегиБлока.Добавить();
		НоваяСтрока.Тег = Выборка.Тег;
		НоваяСтрока.Представление = Выборка.Представление;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтильИСсылкиДоступные()
	
	ТекстСсылки = "";
	
	ВыбранныеТеги = Новый Массив;
	Для Каждого Строка Из ТаблицаТегиБлока Цикл
		ВыбранныеТеги.Добавить(Строка.Тег);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Теги.Ссылка КАК Тег,
	|	Теги.Наименование КАК Представление
	|ИЗ
	|	Справочник.Теги КАК Теги
	|ГДЕ
	|	Теги.Ссылка НЕ В (&ВыбранныеТеги)
	|	И Теги.Наименование ПОДОБНО &ТекстПоиска
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Запрос.УстановитьПараметр("ВыбранныеТеги", ВыбранныеТеги);
	
	Если ПустаяСтрока(СтрокаПоискаТеги) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Теги.Наименование ПОДОБНО &ТекстПоиска", "");
	Иначе
		Запрос.УстановитьПараметр("ТекстПоиска", "%" + СтрокаПоискаТеги + "%");
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Номер = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Номер = Номер + 1;
		НазваниеКласса = "available-" + Номер;
		
		СсылкаНаЭлемент = СтрЗаменить(Строка(Выборка.Тег.УникальныйИдентификатор()), "-", "");
		
		Ссылка = "<div class='item'><a id='" + СсылкаНаЭлемент + "' class='" + НазваниеКласса + 
		"' href='javascript:void(0)';'>" + 
		Выборка.Представление + "</a></div>";
		
		ТекстСсылки = ТекстСсылки + Ссылка;
		
	КонецЦикла;
	
	Если ТекстСсылки = "" Тогда
		ТекстСсылки = "<div style='color: #999; padding: 10px;'>Теги не найдены</div>";
	КонецЕсли;
	
	Результат = Новый Структура("Ссылки", ТекстСсылки);
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСтильИСсылкиВыбранные()
	
	ТекстСсылки = "";
	Номер = 0;
	
	Для Каждого Строка Из ТаблицаТегиБлока Цикл
		
		Номер = Номер + 1;
		НазваниеКласса = "selected-" + Номер;
		
		УИД = Строка.Тег.УникальныйИдентификатор();
		СсылкаНаЭлемент = СтрЗаменить(Строка(УИД), "-", "");
				
		Ссылка = "<div class='item' style='display: inline-flex; align-items: center; gap: 2px;'>" +
	    "<a id='" + СсылкаНаЭлемент + "' class='" + НазваниеКласса + 
	    "' href='javascript:void(0)' color: #fff; display: inline-block; padding: 5px 8px; border-radius: 20px; text-decoration: none;'>" + 
	    Строка.Представление + "</a>" +
	    "<button id='" + СсылкаНаЭлемент + "' class='btn-edit' style='background: #ffa500; color: #fff; border: none; border-radius: 50%; width: 15px; height: 15px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;'>✎</button>" +
	    "<button id='" + СсылкаНаЭлемент + "' class='btn' style='background: #ff4444; color: #fff; border: none; border-radius: 50%; width: 15px; height: 15px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;'>✕</button>" +
	    "</div>";
		
		ТекстСсылки = ТекстСсылки + Ссылка;
		
	КонецЦикла;
	
	Если ТекстСсылки = "" Тогда
		ТекстСсылки = "<div style='color: #999; padding: 10px;'>Нет выбранных тегов</div>";
	КонецЕсли;
	
	Результат = Новый Структура("Ссылки", ТекстСсылки);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьHTML()
	
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьHTMLНаСервере()
	
	Доступные = ПолучитьСтильИСсылкиДоступные();
	Выбранные = ПолучитьСтильИСсылкиВыбранные();
	
	СтрокаНачало = "<html><head><meta charset='windows-1251'><style>
	|body {font-family: Arial, sans-serif; margin: 0; padding: 10px;}
	|a {display: inline-block; padding: 5px 12px; margin: 3px; border: 1px solid; 
	|   border-radius: 20px; font-size: 12px; text-decoration: none; cursor: pointer;}
	|.list {display: flex; flex-wrap: wrap; align-items: center; gap: 5px;}
	|.item {display: inline-flex; align-items: center; gap: 4px; margin: 2px;}
	|.btn-edit, .btn {width: 22px; height: 22px; border-radius: 50%; cursor: pointer; font-size: 12px; 
	|                 display: inline-flex; align-items: center; justify-content: center; border: none;}
	|</style></head><body>";
	
	СтрокаКонец = "</body></html>";
	
	СтрокаHTML = СтрокаНачало +
		"<div style='margin-bottom: 15px;'><b>Выбранные теги:</b></div>" +
		"<div class='list'>" + Выбранные.Ссылки + "</div>" +
		"<div style='margin: 15px 0 10px 0;'><b>Доступные теги:</b></div>" +
		"<div class='list'>" + Доступные.Ссылки + "</div>" +
		СтрокаКонец;
	
	ТегиБлокаПолеHTML = СтрокаHTML;
	
КонецПроцедуры

&НаСервере
Функция ПолеHTMLПриНажатииНаСервере(ГУИД)
	
	ГУИД = СокрЛП(ГУИД);
	
	Если СтрДлина(ГУИД) = 32 Тогда
		ГУИДСДефисами = Лев(ГУИД, 8) + "-" + 
		                 Сред(ГУИД, 9, 4) + "-" + 
		                 Сред(ГУИД, 13, 4) + "-" + 
		                 Сред(ГУИД, 17, 4) + "-" + 
		                 Сред(ГУИД, 21, 12);
		ГУИД = ГУИДСДефисами;
	КонецЕсли;
	
	
	УИД = Новый УникальныйИдентификатор(ГУИД);
	
	Возврат Справочники.Теги.ПолучитьСсылку(УИД);
	
КонецФункции
#КонецОбласти
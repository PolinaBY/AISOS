#Область СлужебныеПроцедурыИФункции    

// Возвращает ссылку на первый эталонный ответ, принадлежащий указанному владельцу (вопросу).
// Используется для отображения существующего эталонного ответа в форме вопроса.
//
// Параметры:
//   Владелец - СправочникСсылка.Вопросы - вопрос, для которого нужно получить эталонный ответ.
//
// Возвращаемое значение:
//   СправочникСсылка.ЭталонныеОтветы - ссылка на эталонный ответ или пустая ссылка.
//
// Пример:
//  Эталон = ПолучитьЭталонныйОтвет(ВопросСсылка);
//
Функция ПолучитьЭталонныйОтвет(Владелец) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭталонныеОтветы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЭталонныеОтветы КАК ЭталонныеОтветы
	|ГДЕ
	|	ЭталонныеОтветы.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Если НЕ ЗначениеЗаполнено(Выборка.Ссылка) Тогда
		Результат = Справочники.ЭталонныеОтветы.ПустаяСсылка();
	Иначе
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает новый вариант ответа для вопроса с выбором ответа.
//
// Параметры:
//   Владелец - СправочникСсылка.Вопросы - вопрос-владелец.
//   Текст    - Строка - текст варианта ответа.
//   Верный   - Булево - признак правильности варианта.
//
// Пример:
//  СоздатьВариантОтвета(ВопросСсылка, "Да", Истина);
//
Процедура СоздатьВариантОтвета(Владелец, Текст, Верный) Экспорт
	
	НовыйВариант = Справочники.ВариантыОтветов.СоздатьЭлемент();
	НовыйВариант.Заполнить(Неопределено);
	НовыйВариант.ВариантОтвета = Текст;
	НовыйВариант.Верно = Верный;
	НовыйВариант.Владелец = Владелец;
	НовыйВариант.Записать();
	
КонецПроцедуры  

// Создает новый вопрос и ответы для него.
//
// Параметры:
//   БлокВопросов - СправочникСсылка.БлокиВопросов - блок-владелец.
//   ТипВопроса   - СправочникСсылка.ТипыВопросов - типы вопросов.
//   Результат    - Структура - результат генерации (содержит Варианты или Эталон).
// 
// Пример:
//  СоздатьВопрос(БлокСсылка, ВыборОтвета, Результат);
//
Процедура СоздатьВопрос(БлокВопросов, ТипВопроса, Результат) Экспорт
	
	НовыйВопрос = Справочники.Вопросы.СоздатьЭлемент();
	НовыйВопрос.Заполнить(Неопределено);
	НовыйВопрос.Блок = БлокВопросов;
	НовыйВопрос.ТипВопроса = ТипВопроса;
	НовыйВопрос.ВключатьВТест = Истина; 
	
	Если ЗначениеЗаполнено(Результат.Вопрос) Тогда
		Документ = Новый ФорматированныйДокумент;
		Документ.Добавить(Результат.Вопрос);
		НовыйВопрос.Вопрос = Новый ХранилищеЗначения(Документ, Новый СжатиеДанных);
		НовыйВопрос.ТекстВопроса = Документ.ПолучитьТекст();
	КонецЕсли; 
	
	НовыйВопрос.Записать(); 
	
	СохранитьОтветы(НовыйВопрос.Ссылка, Результат, ТипВопроса);
	
КонецПроцедуры

// Создает новый эталонный ответ для вопроса с ручным вводом.
//
// Параметры:
//   Владелец - СправочникСсылка.Вопросы - вопрос-владелец.
//   Текст    - Строка - текст эталонного ответа.
//
// Возвращаемое значение:
//   СправочникСсылка.ЭталонныеОтветы - ссылка на созданный эталонный ответ.
// 
// Пример:
//  Ссылка = СоздатьЭталонныйОтвет(ВопросСсылка, "Москва");
//
Функция СоздатьЭталонныйОтвет(Владелец, Текст) Экспорт
	
	НовыйЭталон = Справочники.ЭталонныеОтветы.СоздатьЭлемент(); 
	НовыйЭталон.Заполнить(Неопределено);
	НовыйЭталон.Ответ = Текст;
	НовыйЭталон.Владелец = Владелец;
	НовыйЭталон.Записать();
	
	Возврат НовыйЭталон.Ссылка;
	
КонецФункции

// Полностью удаляет все варианты и эталонные ответы, принадлежащие указанному владельцу (вопросу).
// Вызывается перед записью новых ответов при генерации или изменении вопроса.
// Работает в привилегированном режиме для гарантированного удаления.
//
// Параметры:
//   Владелец - СправочникСсылка.Вопросы - вопрос, для которого удаляются ответы.
//
// Пример:
//  УдалитьОтветы(ВопросСсылка);
//
Процедура УдалитьОтветы(Владелец) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВариантыОтветов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВариантыОтветов КАК ВариантыОтветов
	|ГДЕ
	|	ВариантыОтветов.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Владелец);  
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбъектВариант = Выборка.Ссылка.ПолучитьОбъект(); 
		ОбъектВариант.Удалить();
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЭталонныеОтветы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЭталонныеОтветы КАК ЭталонныеОтветы
	|ГДЕ
	|	ЭталонныеОтветы.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Владелец); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		ОбъектВариант = Выборка.Ссылка.ПолучитьОбъект(); 
		ОбъектВариант.Удалить();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь)
	
КонецПроцедуры

// Сохраняет сгенерированные ответы (варианты или эталоны) в справочники.
// Предварительно удаляет все существующие ответы для указанного вопроса.
//
// Параметры:
//   СсылкаНаВопрос - СправочникСсылка.Вопросы - вопрос, для которого сохраняются ответы.
//   Результат      - Структура - результат генерации (содержит Варианты или Эталон).
//   ТипВопроса     - СправочникСсылка.ТипыВопросов - тип вопроса.
//  
// Пример:
//  Ссылка = СохранитьОтветы(ВопросСсылка, Результат, РучнойВвод);
//
Процедура СохранитьОтветы(СсылкаНаВопрос, Результат, ТипВопроса) Экспорт
	
	УдалитьОтветы(СсылкаНаВопрос);
	МножественныеОтветы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТипВопроса, "МножественныеОтветы");
	
	Если МножественныеОтветы Тогда
		Для Каждого Вариант Из Результат.Варианты Цикл
			СоздатьВариантОтвета(СсылкаНаВопрос, Вариант.Текст, Вариант.Верный);  
		КонецЦикла;
	Иначе
		СоздатьЭталонныйОтвет(СсылкаНаВопрос, Результат.Эталон); 
	КонецЕсли;
	
КонецПроцедуры 

// Генерирует тестовые задания на основе содержимого загруженного файла с использованием GigaChat. 
//
// Параметры:
//   АдресФайла - Строка - Адрес файла во временном хранилище, полученный после
//     вызова ПоместитьВоВременноеХранилище().
//   ДополнительныеПараметры - Структура - Параметры генерации (необязательный).
//
// Пример:
//  Параметры = Новый Структура("КоличествоБлоков", 5);
//  СгенерироватьТестыИзФайла(АдресФайла, Параметры);
//
Процедура СгенерироватьТестыИзФайла(Знач АдресФайла, Знач ДополнительныеПараметры) Экспорт
	
	ПутьКФайлу = ПолучитьИзВременногоХранилища(АдресФайла);
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Тесты", Новый Массив);
	Результат.Вставить("Ошибка", "");
	
	Попытка
		ИДФайла = GigaChatРаботаВызовСервера.ЗагрузитьФайлВGigaChat(ПутьКФайлу);
		
		Если ПустаяСтрока(ИДФайла) Тогда
			Результат.Ошибка = "Не удалось загрузить файл в GigaChat";
			Возврат;
		КонецЕсли;
		
		КоличествоБлоков = 3;
		Если ДополнительныеПараметры.Свойство("КоличествоБлоков") Тогда
			КоличествоБлоков = ДополнительныеПараметры.КоличествоБлоков;
		КонецЕсли;
		
		РезультатГенерации = GigaChatРаботаВызовСервера.СгенерироватьТестыИзФайла(ИДФайла, КоличествоБлоков);
		
		Если Не РезультатГенерации.Успех Тогда
			Результат.Ошибка = РезультатГенерации.Ошибка;
		Иначе
			Результат.Успешно = Истина;
			Результат.Тесты = РезультатГенерации.Тесты;
			Результат.Тест = РезультатГенерации.Тест;
		КонецЕсли;
		
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(
		"GigaChat.ГенерацияТестовИзФайла",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке) + Символы.ПС +
		"ПутьКФайлу: " + ПутьКФайлу + Символы.ПС +
		"КоличествоБлоков: " + Строка(КоличествоБлоков)
		);
		
		Результат.Ошибка = НСтр("ru = 'Ошибка при генерации тестов из файла'") + Символы.ПС +
		ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
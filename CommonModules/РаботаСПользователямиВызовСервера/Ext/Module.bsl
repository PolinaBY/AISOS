// Создает профиль групп доступа, если профиля с указанным наименованием еще не существует.
// Параметры:
//	ОписаниеПрофиля - Структура - структура, полученная с помощью функции ПолучитьОписаниеПрофиляГруппДоступа.
//
Процедура СоздатьПрофильГруппДоступа(ОписаниеПрофиля)
	
	Если ОписаниеПрофиля = Неопределено Тогда
		Возврат;
	КонецЕсли;      
	
	НаименованиеПрофиля = ОписаниеПрофиля.Наименование;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИСТИНА КАК Профиль
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
	|ГДЕ
	|	ПрофилиГруппДоступа.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", НаименованиеПрофиля);
	Если Запрос.Выполнить().Пустой() Тогда
		ПрофильОбъект = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();  
		ПрофильОбъект.Заполнить(Неопределено);  
		ПрофильОбъект.ИдентификаторПоставляемыхДанных = Новый УникальныйИдентификатор(ОписаниеПрофиля.Идентификатор);
		ПрофильОбъект.Наименование = НаименованиеПрофиля; 
	
		ПрофильОбъект.Записать();
	КонецЕсли;
	
	Для каждого Роль Из ОписаниеПрофиля.Роли Цикл
		МетаданныеРоли = Метаданные.Роли.Найти(Роль);
		Если МетаданныеРоли = Неопределено Тогда
			ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При обновлении поставляемого профиля ""%1""
			|обнаружена несуществующая роль ""%2"".'"),
			ОписаниеПрофиля.Наименование,
			Роль);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		ПрофильОбъект.Роли.Добавить().Роль = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеРоли);
	КонецЦикла;
	
	НоваяСтрокаНазначения = ПрофильОбъект.Назначение.Добавить();
    НоваяСтрокаНазначения.ТипПользователей = "Пользователи";
	ПрофильОбъект.Записать(); 
	
КонецПроцедуры

// Добавляет пользователя в новую или уже существующую группу доступа.
// 
// Параметры:
//	НаименованиеПрофиля - Строка - наименование профиля, в которую необходимо добавить пользователя.
//		Если группы доступа с указанным наименованием не существует, то она будет создана автоматически.
//	Пользователь - СправочникСсылка.Пользователи - добавляемый пользователь.
//
Процедура ДобавитьПользователяВГруппуДоступа(НаименованиеПрофиля, Пользователь)
	
	Если НаименованиеПрофиля = "Руководитель" Тогда
		НаименованиеГруппы = НСтр("ru = 'Руководители'");
	ИначеЕсли НаименованиеПрофиля = "Методолог" Тогда
		НаименованиеГруппы = НСтр("ru = 'Методологи'");
	ИначеЕсли НаименованиеПрофиля = "Проверяющий" Тогда
		НаименованиеГруппы = НСтр("ru = 'Проверяющие'");
	ИначеЕсли НаименованиеПрофиля = "Сотрудник" Тогда
		НаименованиеГруппы = НСтр("ru = 'Сотрудники'");
	Иначе
		НаименованиеГруппы = НаименованиеПрофиля;
	КонецЕсли;
	
	Профиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(НаименованиеПрофиля);
	
	Если Профиль = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Профиль группы доступа '%1' не найден", НаименованиеПрофиля);
	КонецЕсли;
	
	ГруппаДоступа = Справочники.ГруппыДоступа.НайтиПоНаименованию(НаименованиеГруппы);
	
	Если Не ЗначениеЗаполнено(ГруппаДоступа) Тогда
		ГруппаДоступаОбъект = Справочники.ГруппыДоступа.СоздатьЭлемент();  
		ГруппаДоступаОбъект.Заполнить(Неопределено);
		ГруппаДоступаОбъект.Наименование = НаименованиеГруппы;
		ГруппаДоступаОбъект.Профиль = Профиль;    
	Иначе
		ГруппаДоступаОбъект = ГруппаДоступа.ПолучитьОбъект();
	КонецЕсли;
		
	ГруппаДоступаОбъект.Пользователи.Добавить().Пользователь = Пользователь;
	
	ГруппаДоступаОбъект.ОбменДанными.Загрузка = Истина;
	ГруппаДоступаОбъект.Записать();
	
	УправлениеДоступом.ОбновитьРолиПользователей();
	
КонецПроцедуры


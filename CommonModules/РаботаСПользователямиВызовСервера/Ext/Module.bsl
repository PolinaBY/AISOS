#Область ПрограммныйИнтерфейс 

// Выполняет первичную инициализацию информационной базы при первом запуске.
// Создает пользователей системы и устанавливает начальные настройки подключения к GigaChat.
//
Процедура ИнициализироватьПриПервомЗапуске() Экспорт
	
	Если Константы.ЗаголовокСистемы.Получить() = "" Тогда
		Константы.ЗаголовокСистемы.Установить(Метаданные.Синоним);
	КонецЕсли; 
	
	СоздатьПользователей(); 
	Константы.НеИспользоватьGigaChat.Установить(Истина);
	Константы.URLАвторизации.Установить("ngw.devices.sberbank.ru");
	Константы.URLAPI.Установить("gigachat.devices.sberbank.ru"); 
	Справочники.ТипыВопросов.ИнициализироватьПредопределенныеЭлементы();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает начальный набор пользователей и профили групп доступа при первом запуске системы.
// Выполняется в привилегированном режиме в рамках одной транзакции.
// При возникновении ошибки транзакция откатывается, и изменения не сохраняются.
//
// Создаваемые пользователи:
//   - Администратор (с полными правами, пароль не задан)
//   - Руководитель (с правами руководителя тестирования)
//   - Методолог (с правами на создание и редактирование вопросов)
//   - Проверяющий (с правами на проверку ответов)
//   - Сотрудник (базовые права для прохождения тестов)
//
// Пароли для всех пользователей не заданы (пустая строка).
// При первом входе пользователи должны установить пароль самостоятельно.
//
// Процедура вызывается из обработчика инициализации системы.
//
Процедура СоздатьПользователей()
	
	НачатьТранзакцию();
	Попытка 
		УстановитьПривилегированныйРежим(Истина);   
		
		СоздатьПрофильГруппДоступа(ПолучитьОписаниеПрофиляГруппДоступа("Руководитель"));
        СоздатьПрофильГруппДоступа(ПолучитьОписаниеПрофиляГруппДоступа("Методолог"));
        СоздатьПрофильГруппДоступа(ПолучитьОписаниеПрофиляГруппДоступа("Проверяющий"));
        СоздатьПрофильГруппДоступа(ПолучитьОписаниеПрофиляГруппДоступа("Сотрудник"));
		
		Пользователи.СоздатьАдминистратора();
		СоздатьПользователя("Руководитель", "Руководитель", ""); 	
		СоздатьПользователя("Методолог", "Методолог", "");	
		СоздатьПользователя("Проверяющий", "Проверяющий", "");
		СоздатьПользователя("Сотрудник", "Сотрудник", "");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();     
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		УстановитьПривилегированныйРежим(Ложь);	
		ЗаписьЖурналаРегистрации(
		"Инициализация.СозданиеПользователей",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке) + Символы.ПС +
		"Операция: создание пользователей при инициализации ИБ"
		);
		
		ТекстСообщения = НСтр("ru = 'Ошибка при создании пользователей и профилей доступа'") + Символы.ПС +
		ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке);
		
		ВызватьИсключение(ТекстСообщения, , , , ИнформацияОбОшибке);
	КонецПопытки;
	
КонецПроцедуры

// Создает пользователя информационной базы и связанные с ним объекты:
//   - запись в справочнике "Пользователи"
//   - запись в справочнике "Сотрудники"
//   - включение пользователя в соответствующую группу доступа
//
// Параметры:
//   Имя               - Строка - имя пользователя для входа в систему
//   ПолноеИмя         - Строка - полное имя пользователя (отображается в интерфейсе)
//   Пароль            - Строка - пароль для аутентификации (пустая строка - без пароля)
//   ЭтоАдминистратор  - Булево - если Истина, пользователю назначаются все существующие роли
//
Процедура СоздатьПользователя(Имя, ПолноеИмя, Пароль)
		
	НовыйСотрудник = Справочники.Сотрудники.СоздатьЭлемент();
	НовыйСотрудник.Заполнить(Неопределено);
	НовыйСотрудник.Наименование = ПолноеИмя;
	НовыйСотрудник.Записать();
	
	НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
	НовыйПользователь.Заполнить(Неопределено); 
	
	ОписаниеПользователяИБ = Новый Структура;
	ОписаниеПользователяИБ.Вставить("Действие", "Записать");
	ОписаниеПользователяИБ.Вставить("ВходВПрограммуРазрешен", Истина);
	ОписаниеПользователяИБ.Вставить("ПотребоватьСменуПароляПриВходе", Ложь); 
	ОписаниеПользователяИБ.Вставить("Имя", Имя);
	ОписаниеПользователяИБ.Вставить("СоздатьНового", Истина); 
	ОписаниеПользователяИБ.Вставить("АутентификацияСтандартная", Истина);      
	
	НовыйПользователь.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);
	НовыйПользователь.Наименование = Имя;
	НовыйПользователь.Сотрудник = НовыйСотрудник.Ссылка;	
	НовыйПользователь.Недействителен = Ложь;
	
	НовыйПользователь.Записать();

	ДобавитьПользователяВГруппуДоступа(Имя, НовыйПользователь.Ссылка);	
КонецПроцедуры


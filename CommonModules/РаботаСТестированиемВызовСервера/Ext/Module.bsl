#Область СлужебныеПроцедурыИФункции

// Загружает начальные данные для информационной панели сотрудника:
// - текущий назначенный тест
// - список всех доступных тестов с их наименованиями
//
// Параметры:
//   Сотрудник - СправочникСсылка.Сотрудники - сотрудник, для которого загружаются данные.
//
// Возвращаемое значение:
//   Структура - содержит поля:
//     ТестСотрудника (СправочникСсылка.Тесты) - текущий назначенный тест
//     СписокТестов (Массив структур с полями Тест, Наименование) - список доступных тестов
//
// Пример:
//  Данные = ЗагрузитьНачальныеДанныеНаСервере(Сотрудник);
//
Функция ЗагрузитьНачальныеДанныеНаСервере(Сотрудник) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТестСотрудника", Справочники.Тесты.ПустаяСсылка());
	Результат.Вставить("СписокТестов", Новый Массив);
	
	Если Сотрудник.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТестыСотрудников.Тест КАК Тест
	|ИЗ
	|	РегистрСведений.ТестыСотрудников.СрезПоследних(&МоментВремени, Сотрудник = &Сотрудник) КАК ТестыСотрудников"; 
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник); 
	Запрос.УстановитьПараметр("МоментВремени", ТекущаяДатаСеанса());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.ТестСотрудника = Выборка.Тест;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =           
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТестыСотрудников.Тест КАК Тест,
	|	ТестыСотрудников.Тест.Наименование КАК Наименование,
	|	ТестыСотрудников.КрайняяДатаПрохождения КАК КрайняяДатаПрохождения
	|ИЗ
	|	РегистрСведений.ТестыСотрудников КАК ТестыСотрудников
	|ГДЕ
	|	ТестыСотрудников.Сотрудник = &Сотрудник
	|	И (ТестыСотрудников.КрайняяДатаПрохождения >= &ТекущаяДата
	|			ИЛИ ТестыСотрудников.КрайняяДатаПрохождения = ДАТАВРЕМЯ(1, 1, 1))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТестыСотрудников.Тест.Приоритет";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		ПустаяКрайняяДата = Выборка.КрайняяДатаПрохождения;
		
		Если Не ПустаяКрайняяДата = Дата('00010101')  Тогда
			Наименование = СтрШаблон( "%1 (пройдите тест до %2)", Выборка.Наименование, Формат(Выборка.КрайняяДатаПрохождения,"ДФ=дд.ММ.гггг")); 
		Иначе
			Наименование = Выборка.Наименование;
		КонецЕсли;
		
		Элемент = Новый Структура("Тест, Наименование", Выборка.Тест, Наименование);
		Результат.СписокТестов.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает список блоков вопросов для указанного теста, доступных сотруднику.
// Также определяет, были ли изменены блоки (для отображения рекомендации пересдать).
//
// Параметры:
//   Сотрудник - СправочникСсылка.Сотрудники - сотрудник, проходящий тест.
//   Тест      - СправочникСсылка.Тесты      - тест, для которого загружаются блоки.
//
// Возвращаемое значение:
//   Структура - содержит поля:
//     Блоки (Массив структур с полями Блок, Наименование) - список блоков
//     БлокиБылиИзменены (Булево) - признак, что хотя бы один блок был изменен
// 
// Пример:
//  Данные = ПолучитьДоступныеБлоки(Сотрудник, Тест);
//
Функция ПолучитьДоступныеБлоки(Сотрудник, Тест) Экспорт
	
	Результат = Новый Массив;  
	
	Если Сотрудник.Пустая() ИЛИ Тест.Пустая() Тогда
		Возврат Новый Структура("Блоки", Результат);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 		
	"ВЫБРАТЬ
	|	ТестыСоставТеста.БлокВопросов КАК БлокВопросов,
	|	ТестыСоставТеста.БлокВопросов.Наименование КАК БлокВопросовНаименование,
	|	ТестыСоставТеста.КоличествоВопросов КАК КоличествоВопросов
	|ПОМЕСТИТЬ ВТ_БокиТеста
	|ИЗ
	|	Справочник.Тесты.СоставТеста КАК ТестыСоставТеста
	|ГДЕ
	|	ТестыСоставТеста.Ссылка = &Тест
	|	И ТестыСоставТеста.ВключатьВТест = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	БлокВопросов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_БокиТеста.БлокВопросов КАК БлокВопросов,
	|	ВТ_БокиТеста.БлокВопросовНаименование КАК БлокВопросовНаименование,
	|	ВТ_БокиТеста.КоличествоВопросов КАК КоличествоВопросов,
	|	РезультатыТестированияСрезПоследних.ВсегоВопросов КАК ВсегоВопросов,
	|	ЕСТЬNULL(РезультатыТестированияСрезПоследних.КоличествоВерныхОтветов, 0) КАК КоличествоВерныхОтветов,
	|	ВЫБОР
	|		КОГДА РезультатыТестированияСрезПоследних.КоличествоВерныхОтветов * 100 / РезультатыТестированияСрезПоследних.ВсегоВопросов >= РезультатыТестированияСрезПоследних.Тестирование.НеобходимыйПроцентВыполнения
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РезультатТестирования
	|ПОМЕСТИТЬ Вт_Результаты
	|ИЗ
	|	ВТ_БокиТеста КАК ВТ_БокиТеста
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.РезультатыТестирования.СрезПоследних(
	|				&МоментВремени,
	|				Сотрудник = &Сотрудник
	|					И ТестНаМоментПрохождения = &Тест) КАК РезультатыТестированияСрезПоследних
	|		ПО ВТ_БокиТеста.БлокВопросов = РезультатыТестированияСрезПоследних.БлокВопросов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Вт_Результаты.БлокВопросов КАК БлокВопросов,
	|	Вт_Результаты.БлокВопросовНаименование КАК БлокВопросовНаименование,
	|	Вт_Результаты.КоличествоВопросов КАК КоличествоВопросов,
	|	Вт_Результаты.ВсегоВопросов КАК ВсегоВопросов,
	|	Вт_Результаты.КоличествоВерныхОтветов КАК КоличествоВерныхОтветов
	|ИЗ
	|	Вт_Результаты КАК Вт_Результаты";          
	
	Запрос.УстановитьПараметр("МоментВремени", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Тест", Тест);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		БлокИзменен = Ложь;
		КоличествоВерныхОтветов = Выборка.КоличествоВерныхОтветов;
		КоличествоВопросов = Выборка.КоличествоВопросов;  
		ВсегоВопросов = Выборка.ВсегоВопросов;
		
		Если КоличествоВерныхОтветов > 0 И Не КоличествоВопросов = ВсегоВопросов Тогда
			БлокИзменен = Истина; 
		КонецЕсли;
		
		Если БлокИзменен Тогда
			Наименование = СтрШаблон("%1 (изменен, рекомендуется пересдать)", Выборка.БлокВопросовНаименование);
		Иначе
			Наименование = Выборка.БлокВопросовНаименование;
		КонецЕсли;
		
		СтруктураБлока = Новый Структура;
		СтруктураБлока.Вставить("Блок", Выборка.БлокВопросов);
		СтруктураБлока.Вставить("Наименование", Наименование);
		
		Результат.Добавить(СтруктураБлока);
		
	КонецЦикла;
	
	Возврат Новый Структура("Блоки, БлокиБылиИзменены", Результат);
	
КонецФункции

// Загружает вопросы для указанного блока с учетом настроек теста.
// Вопросы могут быть случайным образом перемешаны и ограничены по количеству.
//
// Параметры:
//   ТестСотрудника - СправочникСсылка.Тесты      - тест, содержащий настройки блока.
//   БлокВопросов   - СправочникСсылка.БлокиВопросов - блок, из которого загружаются вопросы.
//
// Возвращаемое значение:
//   ТаблицаЗначений - вопросы с полями: Ссылка, ХранилищеВопроса, Текст, ТипВопроса.
// 
// Пример:
//  Данные = ЗагрузитьВопросыНаСервере(ТестСотрудника, БлокВопросов);
//
Функция ЗагрузитьВопросыНаСервере(ТестСотрудника, БлокВопросов) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоставТеста.КоличествоВопросов КАК Количество,
	|	СоставТеста.СлучайныйПорядок КАК СлучайныйПорядок
	|ИЗ
	|	Справочник.Тесты.СоставТеста КАК СоставТеста
	|ГДЕ
	|	СоставТеста.Ссылка = &Тест
	|	И СоставТеста.БлокВопросов = &Блок";
	
	Запрос.УстановитьПараметр("Тест", ТестСотрудника);
	Запрос.УстановитьПараметр("Блок", БлокВопросов);   
	
	РезультатЗапроса = Запрос.Выполнить();
	Строка = РезультатЗапроса.Выбрать();
	
	Если Не Строка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	НужноВопросов = Строка.Количество;
	СлучайныйПорядок = Строка.СлучайныйПорядок;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Вопросы.Ссылка КАК Ссылка,
	|	Вопросы.ТекстВопроса КАК ТекстВопроса,
	|	Вопросы.ТипВопроса КАК ТипВопроса,
	|	Вопросы.ТипВопроса.МножественныеОтветы КАК МножественныеОтветы,
	|	Вопросы.Вопрос КАК Вопрос
	|ИЗ
	|	Справочник.Вопросы КАК Вопросы
	|ГДЕ
	|	Вопросы.Блок = &Блок
	|	И НЕ Вопросы.ПометкаУдаления
	|	И Вопросы.ВключатьВТест = ИСТИНА";
	
	Запрос.УстановитьПараметр("Блок", БлокВопросов);  
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивВопросов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтруктураВопроса = Новый Структура;
		СтруктураВопроса.Вставить("Ссылка", Выборка.Ссылка);
		СтруктураВопроса.Вставить("ХранилищеВопроса", Выборка.Вопрос);
		ТекстДляОтображения = "";   
		Вопрос = Выборка.Вопрос;
		Если НЕ Вопрос = Неопределено Тогда
			Документ = Выборка.Вопрос.Получить();
			ТекстДляОтображения = Документ.ПолучитьТекст();
		КонецЕсли;
		СтруктураВопроса.Вставить("ТекстВопроса", ТекстДляОтображения);
		СтруктураВопроса.Вставить("ТипВопроса", Выборка.ТипВопроса);
		СтруктураВопроса.Вставить("МножественныеОтветы", Выборка.МножественныеОтветы);
		МассивВопросов.Добавить(СтруктураВопроса);
	КонецЦикла;
	
	Если НужноВопросов > МассивВопросов.Количество() Тогда
		НужноВопросов = МассивВопросов.Количество();
	КонецЕсли; 
	
	Если СлучайныйПорядок Тогда
		Генератор = Новый ГенераторСлучайныхЧисел();
		Для Индекс = 0 По МассивВопросов.Количество() - 1 Цикл
			СлучайныйИндекс = Генератор.СлучайноеЧисло(0, Индекс);
			Временный = МассивВопросов[Индекс];
			МассивВопросов[Индекс] = МассивВопросов[СлучайныйИндекс];
			МассивВопросов[СлучайныйИндекс] = Временный;
		КонецЦикла;
	КонецЕсли;
	
	Для Индекс = 0 По НужноВопросов - 1 Цикл
		Элемент = МассивВопросов[Индекс];
		
		Структура = Новый Структура;
		Структура.Вставить("Ссылка", Элемент.Ссылка);
		Структура.Вставить("ХранилищеВопроса", Элемент.ХранилищеВопроса);
		Структура.Вставить("Текст", Лев(Элемент.ТекстВопроса, 500));
		МножественныеОтветы = Элемент.МножественныеОтветы;
		
		Если МножественныеОтветы Тогда
			Структура.Вставить("ТипВопроса", "ВыборОтвета");
		Иначе
			Структура.Вставить("ТипВопроса", "РучнойВвод");
		КонецЕсли;
		
		Результат.Добавить(Структура);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Загружает варианты ответов для указанного вопроса (тип "Выбор ответа").
//
// Параметры:
//   СсылкаНаВопрос - СправочникСсылка.Вопросы - вопрос, для которого загружаются варианты.
//
// Возвращаемое значение:
//   Массив - список структур с полями:
//     * ТекстОтвета - Строка - текст ответа.
//     * Верно - Булево - признак верности ответа.
// 
// Пример:
//  Данные = ПолучитьВариантыОтветов(ВопросСсылка);
//
Функция ПолучитьВариантыОтветов(СсылкаНаВопрос) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВариантыОтветов.ВариантОтвета КАК Текст,
	|	ВариантыОтветов.Верно КАК Верно
	|ИЗ
	|	Справочник.ВариантыОтветов КАК ВариантыОтветов
	|ГДЕ
	|	ВариантыОтветов.Владелец = &Вопрос";
	
	Запрос.УстановитьПараметр("Вопрос", СсылкаНаВопрос); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Структура = Новый Структура;
		Структура.Вставить("ТекстОтвета", Выборка.Текст);
		Результат.Добавить(Структура);
	КонецЦикла; 
	
	Генератор = Новый ГенераторСлучайныхЧисел();
	Для Индекс = 0 По Результат.Количество() - 1 Цикл
		СлучайныйИндекс = Генератор.СлучайноеЧисло(0, Индекс);
		Временный = Результат[Индекс];
		Результат[Индекс] = Результат[СлучайныйИндекс];
		Результат[СлучайныйИндекс] = Временный;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции    

// Проверяет ответ пользователя на вопрос типа "Выбор ответа".
// Сравнивает выбранные пользователем варианты с правильными.
//
// Параметры:
//   СсылкаНаВопрос    - СправочникСсылка.Вопросы - проверяемый вопрос.
//   ОтветПользователя - Строка - ответ пользователя (варианты через "; ").
//
// Возвращаемое значение:
//   Булево - Истина, если ответ верен, Ложь в противном случае.
// 
// Пример:
//  Верен = ПроверитьВыборОтветаНаСервере(СсылкаНаВопрос, "Вариант 1;Вариант 3");
//
Функция ПроверитьВыборОтветаНаСервере(СсылкаНаВопрос, ОтветПользователя) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВариантыОтветов.ВариантОтвета КАК Текст
	|ИЗ
	|	Справочник.ВариантыОтветов КАК ВариантыОтветов
	|ГДЕ
	|	ВариантыОтветов.Владелец = &Вопрос
	|	И ВариантыОтветов.Верно = ИСТИНА";
	
	Запрос.УстановитьПараметр("Вопрос", СсылкаНаВопрос); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выбрать();
	
	Правильные = Новый Массив;
	Пока Результат.Следующий() Цикл
		Правильные.Добавить(НРег(СокрЛП(Результат.Текст)));
	КонецЦикла;
	
	Если ПустаяСтрока(ОтветПользователя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивОтветов = СтрРазделить(ОтветПользователя, ";", Ложь);
	
	Если НЕ МассивОтветов.Количество() = Правильные.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 0 По МассивОтветов.Количество() - 1 Цикл
		ТекОтвет = НРег(СокрЛП(МассивОтветов[Индекс]));
		Если Правильные.Найти(ТекОтвет) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;  
	
КонецФункции

// Проверяет ответ пользователя на вопрос типа "Ручной ввод" с использованием GigaChat.
// При успешной проверке записывает результат в регистр "ОтветыGigaChat".
//
// Параметры:
//   СсылкаНаВопрос    - СправочникСсылка.Вопросы - проверяемый вопрос.
//   ОтветПользователя - Строка - ответ, введенный пользователем.
//   Сотрудник         - СправочникСсылка.Сотрудники - сотрудник, проходивший тест.
//   Тестирование      - ДокументСсылка.Тестирование - документ тестирования.
//
// Возвращаемое значение:
//   Структура - содержит поля:
//     Ответ (Булево) - результат проверки.
//     ОтветGigaChat (Строка) - комментарий GigaChat.
//
// Пример:
//  Ответ = ПроверитьРучнойВводНаСервере(СсылкаНаВопрос, "Москва", Сотрудник, Тестирование);
//
Функция ПроверитьРучнойВводНаСервере(СсылкаНаВопрос, ОтветПользователя, Сотрудник, Тестирование) Экспорт
	
	РезультатПроверки = Новый Структура("Ответ, ОтветGigaChat", Ложь, ""); 
	
	УстановитьПривилегированныйРежим(Истина);
	НеИспользоватьGigaChat = Константы.НеИспользоватьGigaChat.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не НеИспользоватьGigaChat Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭталонныеОтветы.Ответ КАК Текст
		|ИЗ
		|	Справочник.ЭталонныеОтветы КАК ЭталонныеОтветы
		|ГДЕ
		|	ЭталонныеОтветы.Владелец = &Вопрос";
		
		Запрос.УстановитьПараметр("Вопрос", СсылкаНаВопрос); 
		
		РезультатЗапроса = Запрос.Выполнить();
		Результат = РезультатЗапроса.Выбрать();
		
		Эталоны = Новый Массив;
		ТекстВопроса = "";
		
		Пока Результат.Следующий() Цикл
			Эталоны.Добавить(Результат.Текст);
		КонецЦикла;
		
		ЗапросВопрос = Новый Запрос;
		ЗапросВопрос.Текст = "ВЫБРАТЬ
		|	Вопросы.Вопрос КАК Вопрос
		|ИЗ
		|	Справочник.Вопросы КАК Вопросы
		|ГДЕ
		|	Вопросы.Ссылка = &Ссылка";
		ЗапросВопрос.УстановитьПараметр("Ссылка", СсылкаНаВопрос);  
		
		РезультатЗапроса = ЗапросВопрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();  
		
		Если Выборка.Следующий() Тогда
			ХранилищеТекста = Выборка.Вопрос;
			Если Не ХранилищеТекста = Неопределено Тогда
				Документ = ХранилищеТекста.Получить();
				ТекстВопроса = Документ.ПолучитьТекст();
			КонецЕсли;
		КонецЕсли;
		
		Если Эталоны.Количество() = 0 Тогда
			Возврат РезультатПроверки;
		КонецЕсли;
		
		Ответ = GigaChatРаботаВызовСервера.ПроверитьОтвет(ТекстВопроса, ОтветПользователя, Эталоны);
		ПодробныйОтвет = GigaChatРаботаВызовСервера.ПолучитьПодробныйОтвет(ТекстВопроса, ОтветПользователя, Эталоны); 
		
		РезультатПроверки.Ответ = Ответ;
		РезультатПроверки.ОтветGigaChat = ПодробныйОтвет;
		
		GigaChatРаботаВызовСервера.ЗаписатьОтвет(Сотрудник, Тестирование, СсылкаНаВопрос, ТекстВопроса, Эталоны, ОтветПользователя, ПодробныйОтвет, Ответ);
		
	КонецЕсли;  
	
	Возврат РезультатПроверки;    
	
	
КонецФункции

// Создает новый документ "Тестирование" для фиксации прохождения теста сотрудником.
//
// Параметры:
//   Сотрудник     - СправочникСсылка.Сотрудники     - сотрудник, проходящий тест.
//   ТестСотрудника - СправочникСсылка.Тесты         - тест, который проходит сотрудник.
//   БлокВопросов  - СправочникСсылка.БлокиВопросов - блок вопросов, по которому идет тестирование.
//
// Возвращаемое значение:
//   ДокументСсылка.Тестирование - ссылка на созданный документ.
//
// Пример:
//  Тестирование = СоздатьДокументТестирование(Сотрудник, Тестирование, БлокСсылка);
//
Функция СоздатьДокументТестирование(Сотрудник, ТестСотрудника, БлокВопросов) Экспорт
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Организация");
	
	НовыйДокумент = Документы.Тестирование.СоздатьДокумент(); 
	НовыйДокумент.Заполнить(Неопределено);
	НовыйДокумент.Дата = ТекущаяДатаСеанса();
	НовыйДокумент.Сотрудник = Сотрудник;
	НовыйДокумент.Организация = Организация;
	НовыйДокумент.Тест = ТестСотрудника; 
	НовыйДокумент.БлокВопросов = БлокВопросов;
	НовыйДокумент.Подтвержден = Ложь; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТестыСоставТеста.ПроходнойПроцент КАК ПроходнойПроцент
	|ИЗ
	|	Справочник.Тесты.СоставТеста КАК ТестыСоставТеста
	|ГДЕ
	|	ТестыСоставТеста.БлокВопросов = &БлокВопросов";
	
	Запрос.УстановитьПараметр("БлокВопросов", БлокВопросов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовыйДокумент.НеобходимыйПроцентВыполнения = Выборка.ПроходнойПроцент;
	КонецЦикла;
	
	НовыйДокумент.Записать();
	
	Возврат НовыйДокумент.Ссылка; 
	
КонецФункции

// Записывает результаты прохождения теста в документ "Тестирование" и регистр "РезультатыТестирования".
//
// Параметры:
//   СсылкаНаДокументТест - ДокументСсылка.Тестирование - документ для сохранения результатов.
//   Сотрудник           - СправочникСсылка.Сотрудники - сотрудник, проходивший тест.
//   ТестСотрудника      - СправочникСсылка.Тесты      - пройденный тест.
//   БлокВопросов        - СправочникСсылка.БлокиВопросов - пройденный блок.
//   ТаблицаВопросов     - ТаблицаЗначений - результаты по каждому вопросу.
//
// Пример:
//  ЗаписатьРезультатыТеста(Тестирование, Сотрудник,  ТестСсылка, БлокСсылка, ТаблицаВопросов);
//
Процедура ЗаписатьРезультатыТеста(СсылкаНаДокументТест, Сотрудник, ТестСотрудника, БлокВопросов, ТаблицаВопросов) Экспорт
	
	ДокументОбъект = СсылкаНаДокументТест.ПолучитьОбъект();
	
	ВерныхОтветов = 0;
	
	Для Каждого СтрокаТЗ Из ТаблицаВопросов Цикл
		
		ТекстВопросаСтрока = "";
		Если СтрокаТЗ.ХранилищеВопроса <> Неопределено Тогда
			ДокументВопроса = СтрокаТЗ.ХранилищеВопроса.Получить();
			ТекстВопросаСтрока = ДокументВопроса.ПолучитьТекст();
		КонецЕсли;
		
		Если СтрокаТЗ.ТипВопроса = "ВыборОтвета" Тогда
			НоваяСтрока = ДокументОбъект.ВопросыСВыбором.Добавить(); 
			НоваяСтрока.ТипВопроса = Справочники.ТипыВопросов.ВыборОтвета;  
		Иначе
			НоваяСтрока = ДокументОбъект.ВопросыСРучнымВводом.Добавить();  
			НоваяСтрока.ТипВопроса = Справочники.ТипыВопросов.РучнойВвод;
			НоваяСтрока.ОтветGigaChat = СтрокаТЗ.ОтветGigaChat;
		КонецЕсли;
		
		НоваяСтрока.Вопрос = СтрокаТЗ.Ссылка;
		НоваяСтрока.ТекстВопроса = ТекстВопросаСтрока; 
		НоваяСтрока.ОтветПользователя = СтрокаТЗ.ОтветПользователя;        
		НоваяСтрока.Результат = СтрокаТЗ.Результат;
		
		Если СтрокаТЗ.Результат Тогда
			ВерныхОтветов = ВерныхОтветов + 1;
		КонецЕсли;
		
	КонецЦикла;  
	
	ДокументОбъект.Записать();
	
	МенеджерЗаписи = РегистрыСведений.РезультатыТестирования.СоздатьМенеджерЗаписи(); 
	МенеджерЗаписи.Заполнить(Неопределено);
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.Сотрудник = Сотрудник;
	МенеджерЗаписи.ТестНаМоментПрохождения = ТестСотрудника;
	МенеджерЗаписи.БлокВопросов = БлокВопросов;
	МенеджерЗаписи.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Организация");
	МенеджерЗаписи.КоличествоВерныхОтветов = ВерныхОтветов;
	МенеджерЗаписи.ВсегоВопросов = ТаблицаВопросов.Количество();
	МенеджерЗаписи.Тестирование = СсылкаНаДокументТест;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Создает документ апелляция.
//
// Параметры:
//   Сотрудник             - СправочникСсылка.Сотрудники - сотрудник, проходивший тест.
//   СсылкаНаДокументТест  - ДокументСсылка.Тестирование      - текущее тестирование.
//   Текст          	   - Строка - текст апелляции.
//
// Пример:
//  ЗаписатьРезультатыТеста(Сотрудник,  ТестированниеСсылка, "Некорректно сформулирован вопрос №1");
//
Процедура ПодатьАпелляциюНаСервере(Сотрудник, СсылкаНаДокументТест, Текст) Экспорт
	
	Апелляция = Документы.Апелляция.СоздатьДокумент(); 
	Апелляция.Заполнить(Неопределено);
	Апелляция.Дата = ТекущаяДатаСеанса();
	Апелляция.Сотрудник = Сотрудник;
	Апелляция.Тестирование = СсылкаНаДокументТест;
	Апелляция.КомментарийПользователя = Текст;  
	Апелляция.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Организация");
	Апелляция.Записать();
	
КонецПроцедуры

#КонецОбласти
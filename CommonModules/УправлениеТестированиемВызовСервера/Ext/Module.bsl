#Область СлужебныеПроцедурыИФункции

Функция НужноПовыситьУровень(Сотрудник, ТекущийТест) Экспорт
        
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	СоставТестовПоБлокам.БлокВопросов КАК Блок,
    |	Результаты.КоличествоВерныхОтветов КАК ВсегоВерных,
    |	Результаты.Период КАК Период,
    |	ТестыСоставТеста.ПроходнойПроцент КАК ПроходнойПроцент,
    |	ТестыСоставТеста.КоличествоВопросов КАК ВсегоВопросов
    |ПОМЕСТИТЬ ВТ_ВсеДанные
    |ИЗ
    |	РегистрСведений.СоставТестовПоБлокам КАК СоставТестовПоБлокам
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РезультатыТестирования КАК Результаты
    |		ПО СоставТестовПоБлокам.БлокВопросов = Результаты.БлокВопросов
    |			И (Результаты.Сотрудник = &Сотрудник)
    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Тесты.СоставТеста КАК ТестыСоставТеста
    |		ПО СоставТестовПоБлокам.БлокВопросов = ТестыСоставТеста.БлокВопросов
    |ГДЕ
    |	СоставТестовПоБлокам.Тест = &Тест
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	ВТ_ВсеДанные.Блок КАК Блок,
    |	МАКСИМУМ(ВТ_ВсеДанные.Период) КАК МаксПериод
    |ПОМЕСТИТЬ ВТ_МаксПериоды
    |ИЗ
    |	ВТ_ВсеДанные КАК ВТ_ВсеДанные
    |ГДЕ
    |	ВТ_ВсеДанные.Период ЕСТЬ НЕ NULL 
    |
    |СГРУППИРОВАТЬ ПО
    |	ВТ_ВсеДанные.Блок
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	ВТ_ВсеДанные.Блок КАК Блок,
    |	ЕСТЬNULL(ВТ_ВсеДанные.ВсегоВерных, 0) КАК ВсегоВерных,
    |	ВТ_ВсеДанные.ВсегоВопросов КАК ВсегоВопросов,
    |	ВТ_ВсеДанные.ПроходнойПроцент КАК ПроходнойПроцент
    |ИЗ
    |	ВТ_ВсеДанные КАК ВТ_ВсеДанные
    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксПериоды КАК ВТ_МаксПериоды
    |		ПО ВТ_ВсеДанные.Блок = ВТ_МаксПериоды.Блок
    |			И ВТ_ВсеДанные.Период = ВТ_МаксПериоды.МаксПериод
    |
    |УПОРЯДОЧИТЬ ПО
    |	Блок";
    
    Запрос.УстановитьПараметр("Тест", ТекущийТест);
    Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
    
    Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[2].Выбрать();
    
	Пока Выборка.Следующий() Цикл 
		
		ВсегоВопросов = Выборка.ВсегоВопросов;
		ВсегоВерных = Выборка.ВсегоВерных;
		ПроходнойПроцент = Выборка.ПроходнойПроцент;
        
        Если ВсегоВопросов = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
        
        Процент = (ВсегоВерных / ВсегоВопросов) * 100;
        
        Если Процент < ПроходнойПроцент Тогда
            Возврат Ложь;
        КонецЕсли;
        
    КонецЦикла;
    
    Возврат Истина;
	
КонецФункции

Функция ПолучитьСледующийГрейд(ТекущийГрейд, Сотрудник) Экспорт 
	
	ЗапросСотр = Новый Запрос;
	ЗапросСотр.Текст = 
	"ВЫБРАТЬ
	|	Сотрудники.Организация КАК Организация,
	|	Сотрудники.Подразделение КАК Подразделение
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка = &Сотрудник";
	
	ЗапросСотр.УстановитьПараметр("Сотрудник", Сотрудник);
	РезультатСотр = ЗапросСотр.Выполнить();
	ВыборкаСотр = РезультатСотр.Выбрать();
	
	Если Не ВыборкаСотр.Следующий() Тогда
		Возврат Справочники.Тесты.ПустаяСсылка();
	КонецЕсли;
	
	ОргСотрудника = ВыборкаСотр.Организация;
	ПодрСотрудника = ВыборкаСотр.Подразделение;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Тесты.Приоритет КАК Приоритет
	|ИЗ
	|	Справочник.Тесты КАК Тесты
	|ГДЕ
	|	Тесты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ТекущийГрейд); 
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат Справочники.Тесты.ПустаяСсылка();
	КонецЕсли;
	
	ТекущийПорядок = Выборка.Приоритет;

	ЗапросСлед = Новый Запрос;
	ЗапросСлед.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тесты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Тесты КАК Тесты
	|ГДЕ
	|	Тесты.Приоритет > &Приоритет
	|	И (Тесты.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ИЛИ Тесты.Организация = &Организация
	|				И Тесты.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|			ИЛИ Тесты.Организация = &Организация
	|				И Тесты.Подразделение = &Подразделение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Тесты.Приоритет";
	
	ЗапросСлед.УстановитьПараметр("Приоритет", ТекущийПорядок);  
	ЗапросСлед.УстановитьПараметр("Организация", ОргСотрудника);
	ЗапросСлед.УстановитьПараметр("Подразделение", ПодрСотрудника);
	РезультатЗапроса = ЗапросСлед.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Тесты.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции      

#КонецОбласти
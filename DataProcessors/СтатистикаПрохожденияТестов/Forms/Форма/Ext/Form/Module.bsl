#КонецОбласти

#Область СлужебныеПроцедурыИФункции   

&НаСервере
Процедура ЗаполнитьНачальныДанные()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МИНИМУМ(ТестыСотрудниковСрезПоследних.КрайняяДатаПрохождения) КАК КрайняяДатаПрохождения
	|ПОМЕСТИТЬ ВТМоментВремени
	|ИЗ
	|	РегистрСведений.ТестыСотрудников.СрезПоследних(
	|			&ТекущаяДата,
	|			КрайняяДатаПрохождения >= &ТекущаяДата
	|				И НЕ КрайняяДатаПрохождения = &ПустаяДата) КАК ТестыСотрудниковСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ЕСТЬNULL(РезультатыТестирования.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) * 100
	|					КОНЕЦ < РезультатыТестирования.Тестирование.НеобходимыйПроцентВыполнения
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ, 0)) КАК НеПройдено,
	|	СУММА(ЕСТЬNULL(ВЫБОР
	|				КОГДА РезультатыТестирования.Тестирование.Подтвержден = ИСТИНА
	|					ТОГДА 0
	|				ИНАЧЕ 1
	|			КОНЕЦ, 0)) КАК НеПроверено,
	|	ВТМоментВремени.КрайняяДатаПрохождения КАК КрайняяДатаПрохождения
	|ИЗ
	|	РегистрСведений.РезультатыТестирования КАК РезультатыТестирования,
	|	ВТМоментВремени КАК ВТМоментВремени
	|ГДЕ
	|	РезультатыТестирования.Период <= &ТекущаяДата
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТМоментВремени.КрайняяДатаПрохождения";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПустаяДата", Дата('00010101'));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Недостаточно данных для формирования статистики по крайним срокам.");
		
	Иначе
		
		Таблица = РезультатЗапроса.Выгрузить();
		Результат = Таблица[0];
		
		Если Результат.НеПройдено = 0 И Результат.НеПроверено = 0 Тогда
			
			СтатистикаПоКрайнимСрокам = "На данный момент все тесты пройдены и проверенны.";
			
		Иначе 
			СтатистикаПоКрайнимСрокам = СтрШаблон("На данный момент, не пройдено %1 %2, не проверено %3 %4, ближайшая крайняя дата прохождения: %5",
			Результат.НеПройдено, СклонениеЧислительных(Результат.НеПройдено, "тест, теста, тестов"),
			Результат.НеПроверено,СклонениеЧислительных(Результат.НеПроверено, "тест, теста, тестов"),
			Формат(Результат.КрайняяДатаПрохождения, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапроса(УчитыватьТест = Ложь)
	
	Текст = 
	"ВЫБРАТЬ
	|	""ПоОрганизации"" КАК Назначение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РезультатыТестирования.Тестирование) КАК КоличествоТестов,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ЕСТЬNULL(РезультатыТестирования.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) * 100
	|					КОНЕЦ >= РезультатыТестирования.Тестирование.НеобходимыйПроцентВыполнения
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК КоличествоСданныхТестов,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ЕСТЬNULL(РезультатыТестирования.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) * 100
	|					КОНЕЦ < РезультатыТестирования.Тестирование.НеобходимыйПроцентВыполнения
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК КоличествоНеСданныхТестов
	|ИЗ
	|	РегистрСведений.РезультатыТестирования КАК РезультатыТестирования
	|ГДЕ
	|	РезультатыТестирования.Период <= &МоментВремени
	|	И РезультатыТестирования.Сотрудник.Организация = &Организация
	|	И РезультатыТестирования.ТестНаМоментПрохождения = &Тест
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ПоПодразделению"",
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РезультатыТестирования.Тестирование),
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ЕСТЬNULL(РезультатыТестирования.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) * 100
	|					КОНЕЦ >= РезультатыТестирования.Тестирование.НеобходимыйПроцентВыполнения
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0),
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ЕСТЬNULL(РезультатыТестирования.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) * 100
	|					КОНЕЦ < РезультатыТестирования.Тестирование.НеобходимыйПроцентВыполнения
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0)
	|ИЗ
	|	РегистрСведений.РезультатыТестирования КАК РезультатыТестирования
	|ГДЕ
	|	РезультатыТестирования.Период <= &МоментВремени
	|	И РезультатыТестирования.Сотрудник.Организация = &Организация
	|	И РезультатыТестирования.Сотрудник.Подразделение = &Подразделение
	|	И РезультатыТестирования.ТестНаМоментПрохождения = &Тест
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ПоСотруднику"",
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РезультатыТестирования.Тестирование),
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ЕСТЬNULL(РезультатыТестирования.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) * 100
	|					КОНЕЦ >= РезультатыТестирования.Тестирование.НеобходимыйПроцентВыполнения
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0),
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ЕСТЬNULL(РезультатыТестирования.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестирования.ВсегоВопросов, 0) * 100
	|					КОНЕЦ < РезультатыТестирования.Тестирование.НеобходимыйПроцентВыполнения
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0)
	|ИЗ
	|	РегистрСведений.РезультатыТестирования КАК РезультатыТестирования
	|ГДЕ
	|	РезультатыТестирования.Период <= &МоментВремени
	|	И РезультатыТестирования.Сотрудник.Организация = &Организация
	|	И РезультатыТестирования.Сотрудник = &Сотрудник
	|	И РезультатыТестирования.Сотрудник.Подразделение = &Подразделение
	|	И РезультатыТестирования.ТестНаМоментПрохождения = &Тест";
	
	Если НЕ УчитыватьТест Тогда
		Текст = СтрЗаменить(Текст, "И РезультатыТестирования.ТестНаМоментПрохождения = &Тест", ""); 
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции 

&НаСервере
Процедура ОбновитьДанные()
	
	Если Тест.Пустая() Тогда
		УчитыватьТест = Ложь;
	Иначе
		УчитыватьТест = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса(УчитыватьТест);
	
	Запрос.УстановитьПараметр("МоментВремени", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Если УчитыватьТест Тогда
		Запрос.УстановитьПараметр("Тест", Тест);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	
	ИнфПоОрг = ТаблицаРезультата[0];
	ИнфПоПодр = ТаблицаРезультата[1];
	ИнфПоСотр = ТаблицаРезультата[2];
	
	ДиаграммаПоОрганизации.ТипДиаграммы = ТипДиаграммы.КруговаяОбъемная;
	ДиаграммаПоПодразделению.ТипДиаграммы = ТипДиаграммы.КруговаяОбъемная;
	ДиаграммаПоСотруднику.ТипДиаграммы = ТипДиаграммы.КруговаяОбъемная;
	
	Если НЕ Организация.Пустая() Тогда
		
		СтатистикаТестовПоОрганизации = СтрШаблон("По организации %1 всего %2 %3, из которых %4 не пройденно и %5 пройденно.", 
		Организация, ИнфПоОрг.КоличествоТестов, СклонениеЧислительных(ИнфПоОрг.КоличествоТестов, "тест, теста, тестов") , ИнфПоОрг.КоличествоНеСданныхТестов, ИнфПоОрг.КоличествоСданныхТестов);
				
		ПостроитьДиаграмму(ДиаграммаПоОрганизации, "По организации", 
		ИнфПоОрг.КоличествоТестов, ИнфПоОрг.КоличествоСданныхТестов, ИнфПоОрг.КоличествоНеСданныхТестов);
		
	КонецЕсли;
	
	Если НЕ Подразделение.Пустая() Тогда
		
		СтатистикаТестовПоПодразделению = СтрШаблон("По подразделению %1 всего %2 %3, из которых %4 не пройденно и %5 пройденно.", 
		Подразделение, ИнфПоПодр.КоличествоТестов, СклонениеЧислительных(ИнфПоПодр.КоличествоТестов, "тест, теста, тестов"), ИнфПоПодр.КоличествоНеСданныхТестов, ИнфПоПодр.КоличествоСданныхТестов);
		
		ПостроитьДиаграмму(ДиаграммаПоПодразделению, "По подразделению", 
		ИнфПоПодр.КоличествоТестов, ИнфПоПодр.КоличествоСданныхТестов, ИнфПоПодр.КоличествоНеСданныхТестов);
		
	КонецЕсли;
	
	Если НЕ Сотрудник.Пустая() Тогда
		
		СтатистикаТестовПоСотруднику = СтрШаблон("У сотрудника %1 всего %2 %3, из которых %4 не пройдено и %5 пройденно.",
		Сотрудник, ИнфПоСотр.КоличествоТестов, СклонениеЧислительных(ИнфПоСотр.КоличествоТестов, "тест, теста, тестов") ,ИнфПоСотр.КоличествоНеСданныхТестов,ИнфПоСотр.КоличествоСданныхТестов);
		
		ПостроитьДиаграмму(ДиаграммаПоСотруднику, "По сотруднику", 
		ИнфПоСотр.КоличествоТестов, ИнфПоСотр.КоличествоСданныхТестов, ИнфПоСотр.КоличествоНеСданныхТестов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПостроитьДиаграмму(ИскомаяДиаграмма, Назначение, КоличествоТестов, КоличествоСданныхТестов, КоличествоНеСданныхТестов)
	
	ИскомаяДиаграмма.Обновление = Ложь;
	ИскомаяДиаграмма.Очистить();
	ИскомаяДиаграмма.АвтоТранспонирование = Ложь;
	
	СерияТестыВсего = ИскомаяДиаграмма.Серии.Добавить("Тестов всего");
	СерияТестыСданы = ИскомаяДиаграмма.Серии.Добавить("Тестов сдано");
	СерияТестыНеСданы = ИскомаяДиаграмма.Серии.Добавить("Несданных тестов");
	
	Точка = ИскомаяДиаграмма.УстановитьТочку(Назначение);
	ИскомаяДиаграмма.УстановитьЗначение(Точка, СерияТестыВсего, КоличествоТестов, "Тестов всего");
	ИскомаяДиаграмма.УстановитьЗначение(Точка, СерияТестыСданы, КоличествоСданныхТестов, "Тестов сдано");
	ИскомаяДиаграмма.УстановитьЗначение(Точка, СерияТестыНеСданы, КоличествоНеСданныхТестов, "Несданных тестов");
	
	ИскомаяДиаграмма.АвтоТранспонирование = Истина;
	ИскомаяДиаграмма.Обновление = Истина;
	ИскомаяДиаграмма.ОтображатьЛегенду = Ложь;
	
КонецПроцедуры

&НаСервере
Функция СклонениеЧислительных(Число, Слова)
	
	МассивСлов = СтрРазделить(Слова, ",");
	Слово1 = СокрЛП(МассивСлов[0]); 
	Слово2 = СокрЛП(МассивСлов[1]); 
	Слово3 = СокрЛП(МассивСлов[2]); 
	
	Остаток = Число % 10;
	Остаток100 = Число % 100;
	
	Если Остаток100 >= 11 И Остаток100 <= 19 Тогда
		Возврат Слово3;
	КонецЕсли;
	
	Если Остаток = 1 Тогда
		Возврат Слово1;
	ИначеЕсли Остаток >= 2 И Остаток <= 4 Тогда
		Возврат Слово2;
	Иначе
		Возврат Слово3;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

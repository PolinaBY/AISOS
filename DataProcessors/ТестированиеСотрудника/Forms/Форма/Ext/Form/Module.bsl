#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	Объект.Сотрудник = ПараметрыСеанса.ТекущийПользователь.Сотрудник;    
	
	Если НЕ Параметры.ТекущийТест = Неопределено Тогда
		Объект.ТестСотрудника = Параметры.ТекущийТест; 
	КонецЕсли;
	
	Если Объект.Сотрудник.Пустая() Тогда
		Отказ = Истина;   
		ОбщегоНазначения.СообщитьПользователю("Для работы с формой необходимо создать сотрудника. Обратитесь к администратору.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	Элементы.НачальнаяСтраница.Видимость = Истина;
	Элементы.ПанельТеста.Видимость = Ложь; 
	Элементы.Итог.Видимость = Ложь;
	Элементы.ГруппаАпелляция.Видимость = Ложь;
	ЗагрузитьНачальныеДанныеНаСервере();
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказатьАпелляциюПриИзменении(Элемент)
	
	Если ПодатьАпелляцию = Истина Тогда
		Элементы.Итог.Видимость = Ложь;
		Элементы.ГруппаАпелляция.Видимость = Истина;
		ТекстАпелляции = "";
	КонецЕсли;
	
	ПодатьАпелляцию = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура БлокВопросовПриИзменении(Элемент)
	
	БлокВопросовПриИзмененииНаСервере(); 
	
КонецПроцедуры

&НаСервере
Процедура БлокВопросовПриИзмененииНаСервере()
	
	СписокМатериалов.Параметры.УстановитьЗначениеПараметра(
	"Владелец", 
	Объект.БлокВопросов
	);  	
КонецПроцедуры

&НаКлиенте
Процедура ТематикаСотрудникаПриИзменении(Элемент)   
	
	ЗагрузитьДоступныеБлоки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокМатериалов

&НаКлиенте
Процедура СписокМатериаловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(Элемент.ТекущиеДанные.СсылкаНаМатериал);  
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НачатьТест(Команда)  
	
	ЗагрузитьВопросыНаСервере();
	
	Если Объект.ТаблицаВопросов = Неопределено ИЛИ Объект.ТаблицаВопросов.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Нет вопросов для тестирования");
		Возврат;
	КонецЕсли;
	
	Объект.ВсегоВопросов = Объект.ТаблицаВопросов.Количество();
	
	Элементы.НачальнаяСтраница.Видимость = Ложь;
	Элементы.ПанельТеста.Видимость = Истина;
	
	Объект.ТекущийВопрос = 1;
	ПоказатьТекущийВопрос();   
		
	СсылкаНаДокументТест = РаботаСТестированиемВызовСервера.СоздатьДокументТестирование(Объект.Сотрудник, Объект.ТестСотрудника, Объект.БлокВопросов);
		
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	СохранитьТекущийОтвет();
	Объект.ТекущийВопрос = Объект.ТекущийВопрос + 1;
	ПоказатьТекущийВопрос();
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	СохранитьТекущийОтвет();
	Объект.ТекущийВопрос = Объект.ТекущийВопрос - 1;
	ПоказатьТекущийВопрос();
	
КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)  
	
	ТекстВопроса = НСтр("ru = 'Завершить тестирование?'");
	Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодатьАпелляцию(Команда) 
	
	Если ПустаяСтрока(ТекстАпелляции) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните текст апелляции");
		Возврат;
	КонецЕсли;
	
	РаботаСТестированиемВызовСервера.ПодатьАпелляциюНаСервере(Объект.Сотрудник, СсылкаНаДокументТест, ТекстАпелляции);
	ОбщегоНазначенияКлиент.СообщитьПользователю("Апелляция отправлена");
	
	Элементы.ГруппаАпелляция.Видимость = Ложь;
	Элементы.НачальнаяСтраница.Видимость = Истина;
	Объект.ТаблицаВопросов.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Элементы.ГруппаАпелляция.Видимость = Ложь;
	Элементы.Итог.Видимость = Истина;  
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗакрытьАппеляцию(Команда)
	
	Элементы.Итог.Видимость = Ложь;
	Элементы.НачальнаяСтраница.Видимость = Истина;
	Объект.ТаблицаВопросов.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции   

&НаСервере
Процедура ЗагрузитьНачальныеДанныеНаСервере()
	
	Данные = РаботаСТестированиемВызовСервера.ЗагрузитьНачальныеДанныеНаСервере(Объект.Сотрудник);  
	
	Если Объект.ТестСотрудника.Пустая() Тогда
		Объект.ТестСотрудника = Данные.ТестСотрудника; 
	КонецЕсли;
	
	Элементы.ТематикаСотрудника.СписокВыбора.Очистить();
	Для Каждого Тест Из Данные.СписокТестов Цикл
		Элементы.ТематикаСотрудника.СписокВыбора.Добавить(Тест.Тест, Тест.Наименование);
	КонецЦикла;
	
	Если Объект.ТестСотрудника.Пустая() И Данные.СписокТестов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Для сотрудника не назначен Тест. Обратитесь к администратору.");
	КонецЕсли;
	
	ЗагрузитьДоступныеБлоки();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДоступныеБлоки()
	
	Данные = РаботаСТестированиемВызовСервера.ПолучитьДоступныеБлоки(Объект.Сотрудник, Объект.ТестСотрудника);
	
	Элементы.БлокВопросов.СписокВыбора.Очистить();
	
	Для Каждого Блок Из Данные.Блоки Цикл
		Элементы.БлокВопросов.СписокВыбора.Добавить(Блок.Блок, Блок.Наименование);
	КонецЦикла;
	
	Если Данные.Блоки.Количество() = 0 Тогда 
		ОбщегоНазначения.СообщитьПользователю("Все доступные блоки уже пройдены");
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьВопросыНаСервере()
	
	МассивВопросов = РаботаСТестированиемВызовСервера.ЗагрузитьВопросыНаСервере(Объект.ТестСотрудника, Объект.БлокВопросов);
	
	Объект.ТаблицаВопросов.Очистить();
	
	Для Каждого Вопрос Из МассивВопросов Цикл
		НоваяСтрока = Объект.ТаблицаВопросов.Добавить();
		НоваяСтрока.Ссылка = Вопрос.Ссылка;
		НоваяСтрока.ХранилищеВопроса = Вопрос.ХранилищеВопроса;
		НоваяСтрока.Текст = Вопрос.Текст;
		НоваяСтрока.ТипВопроса = Вопрос.ТипВопроса;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекущийВопрос()
	
	Если Объект.ТаблицаВопросов = Неопределено ИЛИ Объект.ТаблицаВопросов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ТекущийВопрос < 1 ИЛИ Объект.ТекущийВопрос > Объект.ТаблицаВопросов.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ТекВопрос = Объект.ТаблицаВопросов[Объект.ТекущийВопрос - 1];
	
	Если ТекВопрос.ХранилищеВопроса <> Неопределено Тогда
		ЗагрузитьДокументНаСервере(ТекВопрос.ХранилищеВопроса);
	Иначе
		Объект.ТекстВопроса = Новый ФорматированныйДокумент;
	КонецЕсли;
	
	Элементы.КоличествоВопросов.Заголовок = "Вопрос " + Объект.ТекущийВопрос + " из " + Объект.ВсегоВопросов;
	
	Если ТекВопрос.ТипВопроса = "ВыборОтвета" Тогда
		Элементы.ГруппаВыбора.Видимость = Истина;
		Элементы.ГруппаВвода.Видимость = Ложь; 
		ЗагрузитьВариантыОтветов(ТекВопрос.Ссылка);    
	Иначе
		Элементы.ГруппаВыбора.Видимость = Ложь;
		Элементы.ГруппаВвода.Видимость = Истина;
	КонецЕсли;
	
	Элементы.Назад.Доступность = (Объект.ТекущийВопрос > 1);
	Элементы.Далее.Доступность = (Объект.ТекущийВопрос < Объект.ВсегоВопросов);  
	Элементы.Далее.КнопкаПоУмолчанию = Элементы.Далее.Доступность;
	Элементы.Завершить.КнопкаПоУмолчанию = Не Элементы.Далее.КнопкаПоУмолчанию;
	
	ВосстановитьТекущийОтвет();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВариантыОтветов(СсылкаНаВопрос)
	
	МассивОтветов = РаботаСТестированиемВызовСервера.ПолучитьВариантыОтветов(СсылкаНаВопрос);
	
	Объект.ВариантыОтветов.Очистить();
	
	Для Каждого Элемент Из МассивОтветов Цикл
		НовыйВариант = Объект.ВариантыОтветов.Добавить();
		НовыйВариант.ТекстОтвета = Элемент.ТекстОтвета;
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДокументНаСервере(ХранилищеДокумента)
	
	Если ХранилищеДокумента = Неопределено Тогда
		Объект.ТекстВопроса = Новый ФорматированныйДокумент;
		Возврат;
	КонецЕсли;
	
	Объект.ТекстВопроса = ХранилищеДокумента.Получить();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьТекущийОтвет()
	
	Если Объект.ТаблицаВопросов = Неопределено ИЛИ Объект.ТаблицаВопросов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекВопрос = Объект.ТаблицаВопросов[Объект.ТекущийВопрос - 1];
	
	Если ТекВопрос.ТипВопроса = "РучнойВвод" Тогда
		ТекВопрос.ОтветПользователя = Объект.РучнойВвод;
		
	ИначеЕсли ТекВопрос.ТипВопроса = "ВыборОтвета" Тогда
		Выбранные = "";
		
		Для Каждого Вариант Из Объект.ВариантыОтветов Цикл
			Если Вариант.Выбран Тогда
				Если Выбранные <> "" Тогда
					Выбранные = Выбранные + "; ";
				КонецЕсли;
				Выбранные = Выбранные + Вариант.ТекстОтвета;
			КонецЕсли;
		КонецЦикла;
		
		ТекВопрос.ОтветПользователя = Выбранные;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТекущийОтвет()
	
	Если Объект.ТаблицаВопросов = Неопределено ИЛИ Объект.ТаблицаВопросов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекВопрос = Объект.ТаблицаВопросов[Объект.ТекущийВопрос - 1];
	
	Если ТекВопрос.ТипВопроса = "РучнойВвод" Тогда
		
		Объект.РучнойВвод = ТекВопрос.ОтветПользователя;
		
	ИначеЕсли ТекВопрос.ТипВопроса = "ВыборОтвета" Тогда
		
		Если ПустаяСтрока(ТекВопрос.ОтветПользователя) Тогда
			Возврат;
		КонецЕсли;
		
		МассивОтветов = СтрРазделить(ТекВопрос.ОтветПользователя, ";", Ложь);
		
		Для Индекс = 0 По МассивОтветов.Количество() - 1 Цикл
			МассивОтветов[Индекс] = СокрЛП(МассивОтветов[Индекс]);
		КонецЦикла;
		
		Для Каждого Вариант Из Объект.ВариантыОтветов Цикл
			Вариант.Выбран = (МассивОтветов.Найти(Вариант.ТекстОтвета) <> Неопределено);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеОтветаНаВопрос(РезультатОпроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатОпроса = КодВозвратаДиалога.Да Тогда
		СохранитьТекущийОтвет();
		ПодсчитатьРезультаты();
		ЗаписатьРезультатыТеста();    
		Элементы.ПанельТеста.Видимость = Ложь;
		Элементы.Итог.Видимость = Истина;
		Объект.ТаблицаВопросов.Очистить(); 
	Иначе
		Возврат; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодсчитатьРезультаты()
	
	Верных = 0;
	
	Для Каждого Вопрос Из Объект.ТаблицаВопросов Цикл
		
		Если Вопрос.ТипВопроса = "ВыборОтвета" Тогда
			Вопрос.Результат = РаботаСТестированиемВызовСервера.ПроверитьВыборОтветаНаСервере(Вопрос.Ссылка, Вопрос.ОтветПользователя);
			
		ИначеЕсли Вопрос.ТипВопроса = "РучнойВвод" Тогда 
			РезультатПроверки =  РаботаСТестированиемВызовСервера.ПроверитьРучнойВводНаСервере(Вопрос.Ссылка, Вопрос.ОтветПользователя, Объект.Сотрудник, СсылкаНаДокументТест);
			Вопрос.Результат = РезультатПроверки.Ответ;
			Вопрос.ОтветGigaChat = РезультатПроверки.ОтветGigaChat;	
		КонецЕсли;
		
		Если Вопрос.Результат Тогда
			Верных = Верных + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.Результат.Заголовок = СтрШаблон("Тест завершен! Верных ответов: %1 из %2", Верных, Объект.ВсегоВопросов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРезультатыТеста()
	
	МассивВопросов = Новый Массив;
	Для Каждого СтрокаТЗ Из Объект.ТаблицаВопросов Цикл
		Структура = Новый Структура;
		Структура.Вставить("Ссылка", СтрокаТЗ.Ссылка);
		Структура.Вставить("ХранилищеВопроса", СтрокаТЗ.ХранилищеВопроса);
		Структура.Вставить("ТипВопроса", СтрокаТЗ.ТипВопроса);
		Структура.Вставить("ОтветПользователя", СтрокаТЗ.ОтветПользователя);
		Структура.Вставить("Результат", СтрокаТЗ.Результат);
		Структура.Вставить("ОтветGigaChat", СтрокаТЗ.ОтветGigaChat);
		МассивВопросов.Добавить(Структура);
	КонецЦикла;
	
	РаботаСТестированиемВызовСервера.ЗаписатьРезультатыТеста(
	СсылкаНаДокументТест, 
	Объект.Сотрудник, 
	Объект.ТестСотрудника, 
	Объект.БлокВопросов, 
	МассивВопросов);
	
КонецПроцедуры
 
#КонецОбласти
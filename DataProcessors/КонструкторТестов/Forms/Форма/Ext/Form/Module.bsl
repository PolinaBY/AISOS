&НаКлиенте
Перем КэшВопросов;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	КэшВопросов = Неопределено;
	ЗагрузитьБлоки();
	
КонецПроцедуры 

#КонецОбласти  

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТестПриИзменении(Элемент)  
	
	КэшВопросов = Неопределено;
	ЗагрузитьБлоки(); 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыБлокиВопросов

&НаКлиенте
Процедура БлокиВопросовПриАктивизацииСтроки(Элемент) 
	
	ТекДанные = Элементы.БлокиВопросов.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ЗагрузитьВопросыБлока(ТекДанные.Блок, КэшВопросов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БлокиВопросовСлучайныйПорядокПриИзменении(Элемент)
	
	ТекущаяСтрокаБлока = Элементы.БлокиВопросов.ТекущиеДанные;
	
	Если ТекущаяСтрокаБлока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрокаБлока.СлучайныйПорядок Тогда
		
		ТекущаяСтрокаБлока.ВключитьВТест = Истина;
		
		Для Каждого СтрокаВопроса Из СписокВопросов Цикл
			СтрокаВопроса.ВключитьВТест = Истина;
		КонецЦикла;
		
		Элементы.СписокВопросов.Обновить();
		
	КонецЕсли; 
	
	ПересчитатьКоличествоВопросовВБлоке();
	
КонецПроцедуры

&НаКлиенте
Процедура БлокиВопросовБлокПриИзменении(Элемент) 
	
	ТекущаяСтрока = Элементы.БлокиВопросов.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйБлок = ТекущаяСтрока.Блок;
	
	Если ЗначениеЗаполнено(ВыбранныйБлок) Тогда 
		КоличествоСовпадений = 0;
        Для Каждого Строка Из БлокиВопросов Цикл
            Если Строка.Блок = ВыбранныйБлок Тогда
                КоличествоСовпадений = КоличествоСовпадений + 1;
            КонецЕсли;
		КонецЦикла; 
		Если КоличествоСовпадений > 1 Тогда
            ОбщегоНазначенияКлиент.СообщитьПользователю("Этот блок уже добавлен в тест");
            ТекущаяСтрока.Блок = Неопределено;
            Элементы.БлокиВопросов.Обновить();
            Возврат;
        КонецЕсли;
		КоличествоВопросов = ПолучитьКоличествоВопросовБлока(ВыбранныйБлок);
		ТекущаяСтрока.ВсегоВопросов = КоличествоВопросов;
	КонецЕсли; 
	
	ЗагрузитьВопросыБлока(ВыбранныйБлок, КэшВопросов);
	
КонецПроцедуры  

#КонецОбласти  

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокВопросов

&НаКлиенте
Процедура СписокВопросовВключитьВТестПриИзменении(Элемент)
	
	ПересчитатьКоличествоВопросовВБлоке();   
	
	ТекущаяСтрока = Элементы.СписокВопросов.ТекущиеДанные;
	Если КэшВопросов = Неопределено Тогда
		КэшВопросов = Новый Соответствие;
	КонецЕсли;
    КэшВопросов.Вставить(ТекущаяСтрока.Ссылка, ТекущаяСтрока.ВключитьВТест);
	
КонецПроцедуры 

#КонецОбласти  

#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура Сохранить(Команда)   
	
	Для Каждого Строка Из БлокиВопросов Цикл
		Если Не ЗначениеЗаполнено(Строка.Блок) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Обнаружена пустая строка в списке блоков. Заполните или удалите её.");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеБлоков = Новый Массив;
	
	Для Каждого Строка Из БлокиВопросов Цикл     
		Если Строка.ВключитьВТест И Строка.КоличествоВопросов > Строка.ВсегоВопросов Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю("Количество выбранных вопросов в блоке не может превышать максимальное количество");
			Возврат;
		КонецЕсли; 
		
		Если Строка.ПроходнойПроцент > 100 Или Строка.ПроходнойПроцент = 0 Тогда 
			Строка.ПроходнойПроцент = 100;   
			ОбщегоНазначенияКлиент.СообщитьПользователю("Проходной процент должен находиться в диапазоне от 1 до 100");
		КонецЕсли;  
		
		Структура = Новый Структура;
		Структура.Вставить("Блок", Строка.Блок);
		Структура.Вставить("Количество", Строка.КоличествоВопросов);
		Структура.Вставить("СлучайныйПорядок", Строка.СлучайныйПорядок); 
		Структура.Вставить("ПроходнойПроцент", Строка.ПроходнойПроцент);
		Структура.Вставить("ВключатьВТест", Строка.ВключитьВТест);
		ДанныеБлоков.Добавить(Структура);
	КонецЦикла;  
	
	СохранитьНастройкиБлоковНаСервере(Тест, ДанныеБлоков);
	
	ДанныеВопросов = Новый Массив;
	Если КэшВопросов <> Неопределено Тогда
		Для Каждого КлючЗначение Из КэшВопросов Цикл
			Структура = Новый Структура;
			Структура.Вставить("Ссылка", КлючЗначение.Ключ);
			Структура.Вставить("Включен", КлючЗначение.Значение);
			ДанныеВопросов.Добавить(Структура);
		КонецЦикла;
	Иначе
		Для Каждого Строка Из СписокВопросов Цикл     
			Структура = Новый Структура;
			Структура.Вставить("Ссылка", Строка.Ссылка); 
			Структура.Вставить("Включен", Строка.ВключитьВТест);
			ДанныеВопросов.Добавить(Структура);
		КонецЦикла;
	КонецЕсли;
	
	СохранитьНастройкиВопросовНаСервере(ДанныеВопросов);
	
	КэшВопросов = Неопределено;
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Настройки сохранены");
	
КонецПроцедуры   

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	Для Каждого Строка Из СписокВопросов Цикл
		Строка.ВключитьВТест = Истина;
	КонецЦикла;  
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсе(Команда)    
	
	Для Каждого Строка Из СписокВопросов Цикл
		Строка.ВключитьВТест = Ложь;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеИзСтолбца(Команда) 
	
	ТекущаяКолонка = Элементы.БлокиВопросов.ТекущийЭлемент;
	
	Если ТекущаяКолонка = Неопределено Или Не ТекущаяКолонка.Вид = ВидПоляФормы.ПолеФлажка Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Установите курсор в нужную колонку таблицы");
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = ТекущаяКолонка.Имя;
	
	Для Каждого Строка Из БлокиВопросов Цикл
		Если ИмяКолонки = "БлокиВопросовВключитьВТест" Тогда
			Строка.ВключитьВТест = Истина;
		ИначеЕсли ИмяКолонки = "БлокиВопросовСлучайныйПорядок" Тогда
			Строка.СлучайныйПорядок = Истина;
		КонецЕсли;
	КонецЦикла;                 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсеИзСтолбца(Команда)  
	
	ТекущаяКолонка = Элементы.БлокиВопросов.ТекущийЭлемент;
	
	Если ТекущаяКолонка = Неопределено Или Не ТекущаяКолонка.Вид = ВидПоляФормы.ПолеФлажка Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Установите курсор в нужную колонку таблицы");
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = ТекущаяКолонка.Имя;
	
	Для Каждого Строка Из БлокиВопросов Цикл
		Если ИмяКолонки = "БлокиВопросовВключитьВТест" Тогда
			Строка.ВключитьВТест = Ложь;
		ИначеЕсли ИмяКолонки = "БлокиВопросовСлучайныйПорядок" Тогда
			Строка.СлучайныйПорядок = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

&НаСервере
Процедура ЗагрузитьБлоки()
	
	БлокиВопросов.Очистить();
	
	Если Тест.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Состав.БлокВопросов КАК Блок,
	|	Состав.БлокВопросов.Наименование КАК Наименование,
	|	Состав.КоличествоВопросов КАК Количество,
	|	КОЛИЧЕСТВО(Вопросы.Ссылка) КАК ВсегоВопросов,
	|	Состав.ПроходнойПроцент КАК ПроходнойПроцент,
	|	Состав.СлучайныйПорядок КАК СлучайныйПорядок,
	|	Состав.ВключатьВТест КАК ВключатьВТест
	|ИЗ
	|	Справочник.Тесты.СоставТеста КАК Состав
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Вопросы КАК Вопросы
	|		ПО Состав.БлокВопросов = Вопросы.Блок
	|ГДЕ
	|	Состав.Ссылка = &Тест
	|	И НЕ Вопросы.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Состав.БлокВопросов,
	|	Состав.БлокВопросов.Наименование,
	|	Состав.КоличествоВопросов,
	|	Состав.ПроходнойПроцент,
	|	Состав.ВключатьВТест,
	|	Состав.СлучайныйПорядок
	|
	|УПОРЯДОЧИТЬ ПО
	|	Состав.БлокВопросов.Наименование";
	
	Запрос.УстановитьПараметр("Тест", Тест);
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выбрать();
	
	Пока Результат.Следующий() Цикл
		НоваяСтрока = БлокиВопросов.Добавить();
		НоваяСтрока.Блок = Результат.Блок;
		НоваяСтрока.КоличествоВопросов = Результат.Количество;
		НоваяСтрока.ВсегоВопросов = Результат.ВсегоВопросов; 
		НоваяСтрока.ПроходнойПроцент = Результат.ПроходнойПроцент; 
		НоваяСтрока.ВключитьВТест = Результат.ВключатьВТест;
		НоваяСтрока.СлучайныйПорядок = Результат.СлучайныйПорядок; 
		Если НоваяСтрока.КоличествоВопросов > НоваяСтрока.ВсегоВопросов Тогда
			НоваяСтрока.КоличествоВопросов = НоваяСтрока.ВсегоВопросов;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьВопросыБлока(Блок, КэшВопросов = Неопределено)
	
	СписокВопросов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Вопросы.Ссылка КАК Ссылка,
	|	Вопросы.ТекстВопроса КАК ТекстВопроса,
	|	Вопросы.ВключатьВТест КАК ВключатьВТест
	|ИЗ
	|	Справочник.Вопросы КАК Вопросы
	|ГДЕ
	|	Вопросы.Блок = &Блок
	|	И НЕ Вопросы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Блок", Блок);
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выбрать();
	
	
	Пока Результат.Следующий() Цикл
		НоваяСтрока = СписокВопросов.Добавить();
		НоваяСтрока.Ссылка = Результат.Ссылка;
		НоваяСтрока.Вопрос = Результат.ТекстВопроса;        
		Если КэшВопросов <> Неопределено Тогда
            Ключ = Результат.Ссылка;
            Если КэшВопросов.Получить(Ключ) <> Неопределено Тогда
                НоваяСтрока.ВключитьВТест = КэшВопросов.Получить(Ключ);
            Иначе
                НоваяСтрока.ВключитьВТест = Результат.ВключатьВТест;
            КонецЕсли;
        Иначе
            НоваяСтрока.ВключитьВТест = Результат.ВключатьВТест;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиБлоковНаСервере(Тест, Данные)
	
	ОбъектТест = Тест.ПолучитьОбъект();
	ОбъектТест.СоставТеста.Очистить();
	
	Для Каждого Элемент Из Данные Цикл
		
		НоваяСтрока = ОбъектТест.СоставТеста.Добавить();
		НоваяСтрока.БлокВопросов = Элемент.Блок;
		НоваяСтрока.КоличествоВопросов = Элемент.Количество;
		НоваяСтрока.СлучайныйПорядок = Элемент.СлучайныйПорядок;
		НоваяСтрока.ПроходнойПроцент = Элемент.ПроходнойПроцент;
		НоваяСтрока.ВключатьВТест = Элемент.ВключатьВТест;      
		
	КонецЦикла;
	
	ОбъектТест.Записать();
	
КонецПроцедуры  

&НаСервере
Процедура СохранитьНастройкиВопросовНаСервере(Данные)
	
	Для Каждого Элемент Из Данные Цикл
		ОбъектВопроса = Элемент.Ссылка.ПолучитьОбъект();
		ОбъектВопроса.ВключатьВТест = Элемент.Включен;
		ОбъектВопроса.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоВопросовБлока(Блок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Вопросы.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.Вопросы КАК Вопросы
	|ГДЕ
	|	Вопросы.Блок = &Блок
	|	И Вопросы.ВключатьВТест = ИСТИНА
	|	И НЕ Вопросы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Блок", Блок);
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьКоличествоВопросовВБлоке()
	
	ТекущаяСтрокаБлока = Элементы.БлокиВопросов.ТекущиеДанные;
	Если ТекущаяСтрокаБлока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоВключенных = 0;
	Для Каждого СтрокаВопроса Из СписокВопросов Цикл
		Если СтрокаВопроса.ВключитьВТест Тогда
			КоличествоВключенных = КоличествоВключенных + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекущаяСтрокаБлока.ВсегоВопросов = КоличествоВключенных;
	
	Если ТекущаяСтрокаБлока.КоличествоВопросов > ТекущаяСтрокаБлока.ВсегоВопросов Тогда
		ТекущаяСтрокаБлока.КоличествоВопросов = ТекущаяСтрокаБлока.ВсегоВопросов;
	КонецЕсли;
	
	Элементы.БлокиВопросов.Обновить();
	
КонецПроцедуры

#КонецОбласти





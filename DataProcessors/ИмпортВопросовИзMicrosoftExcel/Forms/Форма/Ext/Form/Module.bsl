#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	Если Объект.ТабличныйДокумент.ВысотаТаблицы = 0 Тогда   
		ОбщегоНазначенияКлиент.СообщитьПользователю("Колонки заданы неверно");
		Возврат;
	КонецЕсли;
	
	Если Не ВсеКолонкиЗаданы() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Колонки заданы неверно");
		Возврат;
	КонецЕсли;
	
	Данные = ПолучитьВсеДанныеНаСервере();
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеИзФайла = Данные.ДанныеИзФайла;
	СуществующиеБлоки = Данные.Блоки;
	СуществующиеВопросы = Данные.Вопросы;
	СуществующиеВарианты = Данные.Варианты;
	СуществующиеЭталоны = Данные.Эталоны;
	
	Для каждого Строка Из ДанныеИзФайла  Цикл
		Если ПустаяСтрока(Строка.ТекстВопроса) Тогда
			Продолжить;
		КонецЕсли;
		
		БлокСсылка = СуществующиеБлоки.Получить(Строка.Блок);
		Если БлокСсылка = Неопределено Тогда
			БлокСсылка = СоздатьБлокНаСервере(Строка.Блок);
			Если БлокСсылка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СуществующиеБлоки.Вставить(Строка.Блок, БлокСсылка);
		КонецЕсли;
		
		КлючВопроса = Строка.Блок + "|" + Строка.ТекстВопроса;
		СуществующийВопрос = СуществующиеВопросы.Получить(КлючВопроса);
		
		Если СуществующийВопрос = Неопределено Тогда
			
			СоздатьВопросНаСервере(БлокСсылка, Строка);
		Иначе
			Если СуществующийВопрос.МножественныеОтветы Тогда
				СтарыеВарианты = СуществующиеВарианты.Получить(СуществующийВопрос.Ссылка);
				Если СтрЗаменить(СтарыеВарианты, " ", "") <> СтрЗаменить(Строка.ВариантыОтветов, " ", "") Тогда
					ПараметрыВопроса = Новый Структура;
					ПараметрыВопроса.Вставить("Тип", "Варианты");
					ПараметрыВопроса.Вставить("ВопросСсылка", СуществующийВопрос.Ссылка);
					ПараметрыВопроса.Вставить("НовыеВарианты", Строка.ВариантыОтветов);
					ПараметрыВопроса.Вставить("ТекстВопроса", Строка.ТекстВопроса);
					ПараметрыВопроса.Вставить("Блок", Строка.Блок);
					
					ТекстДиалога = СтрШаблон("В блоке %1 уже есть вопрос %2 с другими ответами. Заменить?", Строка.Блок, Строка.ТекстВопроса);
					Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект, ПараметрыВопроса);
					ПоказатьВопрос(Оповещение, ТекстДиалога, РежимДиалогаВопрос.ДаНет);
				Иначе
					ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Пропущен: %1. Уже существует, ответы совпадают", Строка.ТекстВопроса));
				КонецЕсли;
			Иначе
				СтарыйОтвет = СуществующиеЭталоны.Получить(СуществующийВопрос.Ссылка);
				Если СтарыйОтвет <> Строка.ЭталонныеОтветы Тогда
					ПараметрыВопроса = Новый Структура;
					ПараметрыВопроса.Вставить("Тип", "Эталонный");
					ПараметрыВопроса.Вставить("ВопросСсылка", СуществующийВопрос.Ссылка);
					ПараметрыВопроса.Вставить("НовыйОтвет", Строка.ЭталонныеОтветы);
					ПараметрыВопроса.Вставить("ТекстВопроса", Строка.ТекстВопроса);
					ПараметрыВопроса.Вставить("Блок", Строка.Блок);
					
					ТекстДиалога = СтрШаблон("В блоке %1 уже есть вопрос %2 с другим ответом. Заменить?", Строка.Блок, Строка.ТекстВопроса);
					Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект, ПараметрыВопроса);
					ПоказатьВопрос(Оповещение, ТекстДиалога, РежимДиалогаВопрос.ДаНет);
				Иначе
					ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Пропущен: %1. Уже существует, ответы совпадают", Строка.ТекстВопроса));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Загрузка завершена");
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьФайл(Команда)
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите файл";
	ПараметрыДиалога.Фильтр = "Таблица Excel | *.xls; *.xlsx";
	
	ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,,,ПараметрыДиалога);
	Если ОписаниеФайла <> Неопределено Тогда
		
		ПрочитатьФайлНаСервере(ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Расширение);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьШаблон(Команда)
	
	Адрес = ПолучитьМакетНаСервере();
	
	Если ПустаяСтрока(Адрес) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Ошибка при получении макета");
		Возврат;
	КонецЕсли;
	
	НачатьПолучениеФайлаССервера(Адрес, "Шаблон_загрузки_вопросов.xlsx");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьВсеДанныеНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	Если Объект.ТабличныйДокумент.Области.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Нет данных для загрузки");
		Возврат Неопределено;
	КонецЕсли;
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Объект.ТабличныйДокумент.Область());  	
	ТабЗнач = Построитель.Результат.Выгрузить();
	Объект.ТабличныйДокумент.Очистить();
	
	ДанныеИзФайла = Новый Массив;
	УникальныеБлокиИзФайла = Новый Массив;
	УникальныеТипыИзФайла = Новый Массив;
	
	Для каждого СтрокаТЗ Из ТабЗнач Цикл
		Если ПустаяСтрока(СтрокаТЗ.ТекстВопроса) Тогда Продолжить; КонецЕсли;
		
		Строка = Новый Структура;
		Строка.Вставить("ТекстВопроса", СтрокаТЗ.ТекстВопроса);
		Строка.Вставить("ТипВопроса", СтрокаТЗ.ТипВопроса);
		Строка.Вставить("Блок", СтрокаТЗ.Блок);
		Строка.Вставить("ЭталонныеОтветы", СтрокаТЗ.ЭталонныеОтветы);
		Строка.Вставить("ВариантыОтветов", СтрокаТЗ.ВариантыОтветов);
		ДанныеИзФайла.Добавить(Строка);
		
		Если НЕ ПустаяСтрока(СтрокаТЗ.Блок) И УникальныеБлокиИзФайла.Найти(СтрокаТЗ.Блок) = Неопределено Тогда
			УникальныеБлокиИзФайла.Добавить(СтрокаТЗ.Блок);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(СтрокаТЗ.ТипВопроса) И УникальныеТипыИзФайла.Найти(СтрокаТЗ.ТипВопроса) = Неопределено Тогда
			УникальныеТипыИзФайла.Добавить(СтрокаТЗ.ТипВопроса);
		КонецЕсли;
	КонецЦикла;
	
	СуществующиеБлоки = Новый Соответствие;
	ЗапросБлоков = Новый Запрос("ВЫБРАТЬ Наименование, Ссылка ИЗ Справочник.БлокиВопросов");
	ВыборкаБлоков = ЗапросБлоков.Выполнить().Выбрать();
	Пока ВыборкаБлоков.Следующий() Цикл
		СуществующиеБлоки.Вставить(ВыборкаБлоков.Наименование, ВыборкаБлоков.Ссылка);
	КонецЦикла;
	
	СуществующиеТипы = Новый Соответствие;
	ЗапросТипов = Новый Запрос("ВЫБРАТЬ Наименование, Ссылка ИЗ Справочник.ТипыВопросов");
	ВыборкаТипов = ЗапросТипов.Выполнить().Выбрать();
	Пока ВыборкаТипов.Следующий() Цикл
		СуществующиеТипы.Вставить(ВыборкаТипов.Наименование, ВыборкаТипов.Ссылка);
	КонецЦикла;
	
	СуществующиеВопросы = Новый Соответствие; 
	Если УникальныеБлокиИзФайла.Количество() > 0 Тогда
		ЗапросВопросов = Новый Запрос;
		ЗапросВопросов.Текст = "
		|ВЫБРАТЬ
		|	Вопросы.Ссылка КАК Ссылка,
		|	Вопросы.ТекстВопроса КАК ТекстВопроса,
		|	Вопросы.Блок.Наименование КАК Блок,
		|	Вопросы.ТипВопроса.МножественныеОтветы КАК МножественныеОтветы
		|ИЗ
		|	Справочник.Вопросы КАК Вопросы
		|ГДЕ
		|	Вопросы.Блок.Наименование В (&СписокБлоков)";
		
		ЗапросВопросов.УстановитьПараметр("СписокБлоков", УникальныеБлокиИзФайла);
		РезультатВопросов = ЗапросВопросов.Выполнить();
		ВыборкаВопросов = РезультатВопросов.Выбрать();
		
		Пока ВыборкаВопросов.Следующий() Цикл
			Ключ = ВыборкаВопросов.Блок + "|" + ВыборкаВопросов.ТекстВопроса;
			ДанныеВопроса = Новый Структура;
			ДанныеВопроса.Вставить("Ссылка", ВыборкаВопросов.Ссылка);
			ДанныеВопроса.Вставить("МножественныеОтветы", ВыборкаВопросов.МножественныеОтветы);
			СуществующиеВопросы.Вставить(Ключ, ДанныеВопроса);
		КонецЦикла;
	КонецЕсли;
	
	СуществующиеВарианты = Новый Соответствие; 
	Если СуществующиеВопросы.Количество() > 0 Тогда
		СписокВопросов = Новый Массив;
		Для каждого Вопрос Из СуществующиеВопросы Цикл
			СписокВопросов.Добавить(Вопрос.Значение.Ссылка);
		КонецЦикла;
		
		ЗапросВариантов = Новый Запрос;
		ЗапросВариантов.Текст = "
		|ВЫБРАТЬ
		|	Варианты.Владелец КАК Владелец,
		|	Варианты.ВариантОтвета КАК ВариантОтвета,
		|	Варианты.Верно КАК Верно
		|ИЗ
		|	Справочник.ВариантыОтветов КАК Варианты
		|ГДЕ
		|	Варианты.Владелец В (&СписокВопросов)";
		
		ЗапросВариантов.УстановитьПараметр("СписокВопросов", СписокВопросов);
		РезультатВариантов = ЗапросВариантов.Выполнить();
		ВыборкаВариантов = РезультатВариантов.Выбрать();
		
		Пока ВыборкаВариантов.Следующий() Цикл
			Владелец = ВыборкаВариантов.Владелец;
			Строка = СуществующиеВарианты.Получить(Владелец);
			Если Строка = Неопределено Тогда Строка = ""; КонецЕсли;
			Если Строка <> "" Тогда Строка = Строка + ";"; КонецЕсли;
			Если ВыборкаВариантов.Верно Тогда Строка = Строка + "+"; КонецЕсли;
			Строка = Строка + ВыборкаВариантов.ВариантОтвета;
			СуществующиеВарианты.Вставить(Владелец, Строка);
		КонецЦикла;
	КонецЕсли;
	
	СуществующиеЭталоны = Новый Соответствие; 
	Если СуществующиеВопросы.Количество() > 0 Тогда
		СписокВопросов = Новый Массив;
		Для каждого Вопрос Из СуществующиеВопросы Цикл
			СписокВопросов.Добавить(Вопрос.Значение.Ссылка);
		КонецЦикла;
		
		ЗапросЭталонов = Новый Запрос;
		ЗапросЭталонов.Текст = "
		|ВЫБРАТЬ
		|	ЭталонныеОтветы.Владелец КАК Владелец,
		|	ЭталонныеОтветы.Ответ КАК Ответ
		|ИЗ
		|	Справочник.ЭталонныеОтветы КАК ЭталонныеОтветы
		|ГДЕ
		|	ЭталонныеОтветы.Владелец В (&СписокВопросов)";
		
		ЗапросЭталонов.УстановитьПараметр("СписокВопросов", СписокВопросов);
		РезультатЭталонов = ЗапросЭталонов.Выполнить();
		ВыборкаЭталонов = РезультатЭталонов.Выбрать();
		
		Пока ВыборкаЭталонов.Следующий() Цикл
			СуществующиеЭталоны.Вставить(ВыборкаЭталонов.Владелец, ВыборкаЭталонов.Ответ);
		КонецЦикла;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеИзФайла", ДанныеИзФайла);
	Результат.Вставить("Блоки", СуществующиеБлоки);
	Результат.Вставить("Вопросы", СуществующиеВопросы);
	Результат.Вставить("Варианты", СуществующиеВарианты);
	Результат.Вставить("Эталоны", СуществующиеЭталоны);
	Результат.Вставить("Типы", СуществующиеТипы);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеОтветаНаВопрос(РезультатОпроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатОпроса = КодВозвратаДиалога.Да Тогда
		Если ДополнительныеПараметры.Тип = "Варианты" Тогда
			ЗаменитьВариантыНаСервере(ДополнительныеПараметры.ВопросСсылка, ДополнительныеПараметры.НовыеВарианты);
		Иначе
			ЗаменитьЭталонныйОтветНаСервере(ДополнительныеПараметры.ВопросСсылка, ДополнительныеПараметры.НовыйОтвет);
		КонецЕсли;
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМакетНаСервере()
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("МакетИмпортаВопросов");
	
	Если Макет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(Макет, Новый УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция СоздатьБлокНаСервере(Наименование)
	
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйБлок = Справочники.БлокиВопросов.СоздатьЭлемент();
	НовыйБлок.Заполнить(Неопределено);
	НовыйБлок.Наименование = Наименование;
	НовыйБлок.Записать();
	Возврат НовыйБлок.Ссылка;
	
КонецФункции

&НаСервере
Процедура СоздатьВопросНаСервере(БлокСсылка, Строка)
	
	Тип = Справочники.ТипыВопросов.НайтиПоНаименованию(Строка.ТипВопроса);
	Если Тип = Справочники.ТипыВопросов.ПустаяСсылка() Тогда
		Тип = Справочники.ТипыВопросов.СоздатьЭлемент();
		Тип.Заполнить(Неопределено);
		Тип.Наименование = Строка.ТипВопроса;
		Тип.Записать();
	КонецЕсли;
	
	Вопрос = Справочники.Вопросы.СоздатьЭлемент();
	Вопрос.Заполнить(Неопределено);
	Документ = Новый ФорматированныйДокумент;
	Документ.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(Строка.ТекстВопроса));
	Вопрос.Вопрос = Новый ХранилищеЗначения(Документ, Новый СжатиеДанных);
	Вопрос.ТекстВопроса = Документ.ПолучитьТекст();
	Вопрос.ТипВопроса = Тип.Ссылка;
	Вопрос.Блок = БлокСсылка;
	Вопрос.Записать();
	
	Если Тип.МножественныеОтветы Тогда
		Варианты = СтрРазделить(Строка.ВариантыОтветов, ";", Истина);
		Для Каждого Текст Из Варианты Цикл
			Текст = СокрЛП(Текст);
			Если Текст = "" Тогда Продолжить; КонецЕсли;
			Верно = (Лев(Текст, 1) = "+");
			Если Верно Тогда Текст = СокрЛП(Сред(Текст, 2)); КонецЕсли;
			Вариант = Справочники.ВариантыОтветов.СоздатьЭлемент();
			Вариант.Заполнить(Неопределено);
			Вариант.Владелец = Вопрос.Ссылка;
			Вариант.ВариантОтвета = Текст;
			Вариант.Верно = Верно;
			Вариант.Записать();
		КонецЦикла;
	Иначе
		Если НЕ ПустаяСтрока(Строка.ЭталонныеОтветы) Тогда
			Ответ = Справочники.ЭталонныеОтветы.СоздатьЭлемент();
			Ответ.Заполнить(Неопределено);
			Ответ.Владелец = Вопрос.Ссылка;
			Ответ.Ответ = Строка.ЭталонныеОтветы;
			Ответ.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьВариантыНаСервере(ВопросСсылка, НовыеВарианты)
	
	Результат = Новый Структура;
	Результат.Вставить("Вопрос", ВопросСсылка.Ссылка.ТекстВопроса);
	
	Варианты = Новый Массив;
	МассивВариантов = СтрРазделить(НовыеВарианты, ";", Истина);
	Для Каждого ТекстВарианта Из МассивВариантов Цикл
		Текст = СокрЛП(ТекстВарианта);
		Если Текст = "" Тогда Продолжить; КонецЕсли;
		Верно = (Лев(Текст, 1) = "+");
		Если Верно Тогда Текст = СокрЛП(Сред(Текст, 2)); КонецЕсли;
		Варианты.Добавить(Новый Структура("Текст, Верный", Текст, Верно));
	КонецЦикла;
	Результат.Вставить("Варианты", Варианты);
	
	РаботаСВопросамиВызовСервера.СохранитьОтветы(ВопросСсылка.Ссылка, Результат, Справочники.ТипыВопросов.ВыборОтвета);
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьЭталонныйОтветНаСервере(ВопросСсылка, НовыйОтвет)
	
	Результат = Новый Структура;
	Результат.Вставить("Вопрос", ВопросСсылка.Ссылка.ТекстВопроса);
	Результат.Вставить("Эталон", НовыйОтвет);
	
	РаботаСВопросамиВызовСервера.СохранитьОтветы(ВопросСсылка.Ссылка, Результат, Справочники.ТипыВопросов.РучнойВвод);
	
КонецПроцедуры

&НаСервере
Функция ВсеКолонкиЗаданы()
	
	ТабЗнач = Новый ТаблицаЗначений;
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Объект.ТабличныйДокумент.Область());  	
	
	ТабЗнач = Построитель.Результат.Выгрузить();
	
	ИскомыеКолонки = Новый Массив;
	ИскомыеКолонки.Добавить("Блок");
	ИскомыеКолонки.Добавить("ВариантыОтветов");
	ИскомыеКолонки.Добавить("ТекстВопроса");
	ИскомыеКолонки.Добавить("ТипВопроса");
	ИскомыеКолонки.Добавить("ЭталонныеОтветы");
	
	КоличествоКолонокФакт  = ТабЗнач.Колонки.Количество();
	КоличествоКолонокОжид = ИскомыеКолонки.Количество();
	
	Если КоличествоКолонокФакт <> КоличествоКолонокОжид Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ИмяКолонки Из ИскомыеКолонки Цикл
		Колонка = ТабЗнач.Колонки.Найти(ИмяКолонки);
		Если Колонка = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Колонка Из ТабЗнач.Колонки Цикл
		Если ИскомыеКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПрочитатьФайлНаСервере(АдресДанных, РасширениеФайла)
	
	ПутьКфайлу = ПолучитьИмяВременногоФайла(РасширениеФайла);         
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Данные.Записать(ПутьКфайлу);
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Объект.ТабличныйДокумент.Очистить();
	Объект.ТабличныйДокумент.Вывести(ТабДок);
	УдалитьФайлы(ПутьКфайлу);
		
КонецПроцедуры

#КонецОбласти

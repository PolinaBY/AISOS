#Область ОбработчикиСобытийФормы  

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийСотрудник = ПараметрыСеанса.ТекущийПользователь.Сотрудник; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗагрузитьДанныеСотрудника(); 
	
КонецПроцедуры 

#КонецОбласти  

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТекущийТестПриИзменении(Элемент)
	ЗагрузитьДоступныеБлоки();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НачатьТест(Команда) 
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущийТест", ТекущийТест);
	ОткрытьФорму("Обработка.ТестированиеСотрудника.Форма.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	
	ЗагрузитьДанныеСотрудника();
	
КонецПроцедуры

#КонецОбласти 



#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьДанныеСотрудника()  
	
	Данные = РаботаСТестированиемВызовСервера.ЗагрузитьНачальныеДанныеНаСервере(ТекущийСотрудник);
	
	ТекущийТест = Данные.ТестСотрудника;
	
	Элементы.ТекущийТест.СписокВыбора.Очистить();
	Для Каждого Тест Из Данные.СписокТестов Цикл
		Элементы.ТекущийТест.СписокВыбора.Добавить(Тест.Тест, Тест.Наименование);
	КонецЦикла;
	
	Если ТекущийТест.Пустая() И Данные.СписокТестов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Для сотрудника не назначен Тест. Обратитесь к администратору.");
	КонецЕсли;
	
	ЗагрузитьДоступныеБлоки();
	
КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьДоступныеБлоки()
	
	ТаблицаДоступныеБлоки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТестыСоставТеста.БлокВопросов КАК БлокВопросов,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РезультатыТестированияСрезПоследних.ВсегоВопросов, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(РезультатыТестированияСрезПоследних.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестированияСрезПоследних.ВсегоВопросов, 0) * 100
	|	КОНЕЦ КАК Процент,
	|	ТестыСоставТеста.ПроходнойПроцент КАК ПроходнойПроцент
	|ИЗ
	|	Справочник.Тесты.СоставТеста КАК ТестыСоставТеста
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РезультатыТестирования.СрезПоследних(
	|				&Период,
	|				Сотрудник = &Сотрудник
	|					И ТестНаМоментПрохождения = &Тест) КАК РезультатыТестированияСрезПоследних
	|		ПО ТестыСоставТеста.БлокВопросов = РезультатыТестированияСрезПоследних.БлокВопросов
	|ГДЕ
	|	ТестыСоставТеста.Ссылка = &Тест";    
	
	Запрос.УстановитьПараметр("Сотрудник", ТекущийСотрудник);
	Запрос.УстановитьПараметр("Тест", ТекущийТест);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса()); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выбрать();
	
	Пока Результат.Следующий() Цикл
		НоваяСтрока = ТаблицаДоступныеБлоки.Добавить();
		НоваяСтрока.Блок = Результат.БлокВопросов;
		НоваяСтрока.Процент = Результат.Процент;
		НоваяСтрока.ПроходнойПроцент = Результат.ПроходнойПроцент;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти




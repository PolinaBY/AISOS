#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)  
	
	ЗагрузитьСотрудниковНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы  

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ЗагрузитьСотрудниковНаСервере(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	ЗагрузитьСотрудниковНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДолжностьПриИзменении(Элемент)
	
	ЗагрузитьСотрудниковНаСервере();  
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НазначитьТест(Команда)
	
	Если Тест.Пустая() Тогда
		ПоказатьПредупреждение(,"Выберите тест для назначения");
		Возврат;
	КонецЕсли;   
	
	Выбранные = Новый Массив;         
	
	Для Каждого Строка Из Сотрудники Цикл 
				
		Если Строка.Выбрать Тогда
			
			ДанныеТекущейСтроки = Новый Структура;
			ДанныеТекущейСтроки.Вставить("Сотрудник", Строка.Сотрудник);
			ДанныеТекущейСтроки.Вставить("Организация", Строка.Организация);
			ДанныеТекущейСтроки.Вставить("Подразделение", Строка.Подразделение);
			ДанныеТекущейСтроки.Вставить("Должность", Строка.Должность);
			
			Выбранные.Добавить(ДанныеТекущейСтроки);  
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	Если Выбранные.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Выберите хотя бы одного сотрудника");
		Возврат;
	КонецЕсли;
	
	НазначитьТестНаСервере(Выбранные, Тест, КрайняяДатаПрохождения);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Тест назначен";
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)    
	
	Для Каждого Строка Из Сотрудники Цикл
		Строка.Выбрать = Истина;
	КонецЦикла;     
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсе(Команда) 
	
	Для Каждого Строка Из Сотрудники Цикл
		Строка.Выбрать = Ложь;
	КонецЦикла;        
	
КонецПроцедуры

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьСотрудниковНаСервере() 
	
	Сотрудники.Очистить();
	
	ИспользоватьДолжность      = ЗначениеЗаполнено(Должность);
	ИспользоватьПодразделение  = ЗначениеЗаполнено(Подразделение);
	ИспользоватьОрганизация    = ЗначениеЗаполнено(Организация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Организация КАК Организация,
	|	Сотрудники.Подразделение КАК Подразделение,
	|	Сотрудники.Должность КАК Должность
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И (Сотрудники.Должность = &Должность
	|			ИЛИ НЕ &ИспользоватьДолжность)
	|	И (Сотрудники.Подразделение = &Подразделение
	|			ИЛИ НЕ &ИспользоватьПодразделение)
	|	И (Сотрудники.Организация = &Организация
	|			ИЛИ НЕ &ИспользоватьОрганизация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование";
	
	
	Запрос.УстановитьПараметр("ИспользоватьДолжность",      ИспользоватьДолжность);
	Запрос.УстановитьПараметр("Должность",                  Должность);
	Запрос.УстановитьПараметр("ИспользоватьПодразделение",  ИспользоватьПодразделение);
	Запрос.УстановитьПараметр("Подразделение",              Подразделение);
	Запрос.УстановитьПараметр("ИспользоватьОрганизация",    ИспользоватьОрганизация);
	Запрос.УстановитьПараметр("Организация",                Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выбрать();
	
	
	Пока Результат.Следующий() Цикл
		НоваяСтрока = Сотрудники.Добавить();
		НоваяСтрока.Сотрудник    = Результат.Сотрудник;
		НоваяСтрока.Организация  = Результат.Организация; 
		НоваяСтрока.Подразделение = Результат.Подразделение;
		НоваяСтрока.Должность = Результат.Должность;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НазначитьТестНаСервере(ВыбранныеСотрудники, Тест, ДатаОкончания) 
	
	Для Каждого ДанныеСотрудника Из ВыбранныеСотрудники Цикл
		
		НаборЗаписей = РегистрыСведений.ТестыСотрудников.СоздатьНаборЗаписей();
		НаборЗаписей.Заполнить(Неопределено);
		НаборЗаписей.Отбор.Сотрудник.Установить(ДанныеСотрудника.Сотрудник);
		НаборЗаписей.Отбор.Организация.Установить(ДанныеСотрудника.Организация);
		НаборЗаписей.Прочитать();
		
		Запись = НаборЗаписей.Добавить();
		Запись.Период = ТекущаяДатаСеанса();
		Запись.Сотрудник = ДанныеСотрудника.Сотрудник;
		Запись.Организация = ДанныеСотрудника.Организация;
		Запись.Тест = Тест;
		Запись.КрайняяДатаПрохождения = ДатаОкончания; 
		
		НаборЗаписей.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти  
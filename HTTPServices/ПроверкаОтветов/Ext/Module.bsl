#Область СлужебныеПроцедурыИФункции

Функция checkanswerCheck(Запрос)
	
	Если Запрос.Метод <> "POST" Тогда
        Ответ = Новый HTTPСервисОтвет(405);
        Ответ.УстановитьТелоИзСтроки("Только POST метод");
        Возврат Ответ;
    КонецЕсли;
    
    ТелоЗапроса = "";
    Попытка
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
    Исключение
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка чтения тела запроса");
        Возврат Ответ;
    КонецПопытки;
    
    Если ПустаяСтрока(ТелоЗапроса) Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Тело запроса пустое");
        Возврат Ответ;
    КонецЕсли;
    
    Данные = Неопределено;
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
        ЧтениеJSON.Закрыть();
    Исключение
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Неверный формат JSON");
        Возврат Ответ;
    КонецПопытки;
    
    Если Данные = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ожидается JSON объект");
        Возврат Ответ;
    КонецЕсли;
    
    Если Не Данные.Свойство("Вопрос") Или Не Данные.Свойство("ОтветПользователя") Или Не Данные.Свойство("ЭталонныеОтветы") Тогда
        Ответ = Новый HTTPСервисОтвет(422);
        Ответ.УстановитьТелоИзСтроки("Неверный формат JSON");
        Возврат Ответ;
    КонецЕсли;
	
	Результат = GigaChatРаботаВызовСервера.ПроверитьОтвет(
        Данные.Вопрос,
        Данные.ОтветПользователя,
        Данные.ЭталонныеОтветы
    );
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.УстановитьТелоИзСтроки(СтрШаблон("""%1""", Результат));
    Возврат Ответ;
    
КонецФункции

#КонецОбласти

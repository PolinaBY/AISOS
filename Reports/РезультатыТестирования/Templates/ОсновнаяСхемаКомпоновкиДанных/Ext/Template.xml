		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ТестыСотрудников.Сотрудник КАК Сотрудник,
	ТестыСотрудников.Тест КАК Тест
ПОМЕСТИТЬ ВТ_ИсторияТестов
ИЗ
	РегистрСведений.ТестыСотрудников КАК ТестыСотрудников
ГДЕ
	ТестыСотрудников.Сотрудник = &amp;Сотрудник
	И ТестыСотрудников.Период &lt;= &amp;Период

ИНДЕКСИРОВАТЬ ПО
	Тест
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ИсторияТестов.Сотрудник КАК Сотрудник,
	ВТ_ИсторияТестов.Тест КАК Тест,
	ТестыСоставТеста.БлокВопросов КАК БлокВопросов,
	ТестыСоставТеста.Ссылка.Приоритет КАК ПорядокБлока,
	ТестыСоставТеста.ПроходнойПроцент КАК ПроходнойПроцент
ПОМЕСТИТЬ ВТ_БлокиТестов
ИЗ
	ВТ_ИсторияТестов КАК ВТ_ИсторияТестов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Тесты.СоставТеста КАК ТестыСоставТеста
		ПО ВТ_ИсторияТестов.Тест = ТестыСоставТеста.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_БлокиТестов.Сотрудник КАК Сотрудник,
	ВТ_БлокиТестов.Тест КАК Тест,
	ВТ_БлокиТестов.БлокВопросов КАК БлокВопросов,
	ВТ_БлокиТестов.БлокВопросов.Наименование КАК НаименованиеБлока,
	ЕСТЬNULL(РезультатыТестированияСрезПоследних.ВсегоВопросов, 0) КАК ВсегоВопросов,
	ЕСТЬNULL(РезультатыТестированияСрезПоследних.КоличествоВерныхОтветов, 0) КАК КоличествоВерныхОтветов,
	ВЫБОР
		КОГДА ЕСТЬNULL(РезультатыТестированияСрезПоследних.ВсегоВопросов, 0) = 0
			ТОГДА 0
		ИНАЧЕ ЕСТЬNULL(РезультатыТестированияСрезПоследних.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестированияСрезПоследних.ВсегоВопросов, 0) * 100
	КОНЕЦ КАК Процент,
	ВТ_БлокиТестов.ПроходнойПроцент КАК ПроходнойПроцент,
	ВЫБОР
		КОГДА ЕСТЬNULL(РезультатыТестированияСрезПоследних.ВсегоВопросов, 0) = 0
			ТОГДА 0
		ИНАЧЕ ЕСТЬNULL(РезультатыТестированияСрезПоследних.КоличествоВерныхОтветов, 0) / ЕСТЬNULL(РезультатыТестированияСрезПоследних.ВсегоВопросов, 0) * 100
	КОНЕЦ * 100 / ЕСТЬNULL(ВТ_БлокиТестов.ПроходнойПроцент, 1) КАК ПрохождениеТеста
ИЗ
	ВТ_БлокиТестов КАК ВТ_БлокиТестов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РезультатыТестирования.СрезПоследних(&amp;Период, Сотрудник = &amp;Сотрудник) КАК РезультатыТестированияСрезПоследних
		ПО ВТ_БлокиТестов.БлокВопросов = РезультатыТестированияСрезПоследних.БлокВопросов

УПОРЯДОЧИТЬ ПО
	ВТ_БлокиТестов.Тест.Приоритет,
	ВТ_БлокиТестов.ПорядокБлока</query>

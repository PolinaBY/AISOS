
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		ГСЧ = Новый ГенераторСлучайныхЧисел;
		Если ГСЧ.СлучайноеЧисло(1,2) = 1 Тогда
			Объект.ТипВопроса = Справочники.ТипыВопросов.ВыборОтвета;
		Иначе
			Объект.ТипВопроса = Справочники.ТипыВопросов.РучнойВвод;
		КонецЕсли;
	КонецЕсли;
	
	ТекущийОбъектСправочника = РеквизитФормыВЗначение("Объект");
	
	Если ТекущийОбъектСправочника.Вопрос <> Неопределено Тогда
		Документ = ТекущийОбъектСправочника.Вопрос.Получить();
	КонецЕсли;
	
	// Настройки видимости
	ВариантыОтветов.Параметры.УстановитьЗначениеПараметра("Владелец", Объект.Ссылка);
	ЭталонныеОтветы.Параметры.УстановитьЗначениеПараметра("Владелец", Объект.Ссылка); 
	ЭталонныйОтвет = РаботаСВопросамиВызовСервера.ПолучитьЭталонныйОтвет(Объект.Ссылка);   
	
	ТекущийТип = Объект.ТипВопроса;
	Если Не ТекущийТип.Пустая() Тогда
		Элементы.ВариантыОтветов.Видимость = ТекущийТип.МножественныеОтветы;
		Элементы.ЭталонныйОтвет.Видимость = Не ТекущийТип.МножественныеОтветы;
	КонецЕсли;
	
	Объект.ВключатьВТест = Истина;  
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Документ <> Неопределено Тогда
		
		ТекущийОбъект.Вопрос = Новый ХранилищеЗначения(Документ, Новый СжатиеДанных);
		ТекущийОбъект.ТекстВопроса = Документ.ПолучитьТекст();	
	КонецЕсли;  
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьПараметрыВладельцаНаСервере(Объект.Ссылка);
	Элементы.ВариантыОтветов.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Документ = Неопределено И Объект.Вопрос = Неопределено Тогда
		ПоказатьПредупреждение(, "Не заполнен текст вопроса");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.ТипВопроса.Пустая() Тогда
		ПоказатьПредупреждение(, "Не выбран тип вопроса");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект) 
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если Документ <> Неопределено Тогда
		
		ТекущийОбъект.Вопрос = Новый ХранилищеЗначения(Документ, Новый СжатиеДанных);
		ТекущийОбъект.ТекстВопроса = Документ.ПолучитьТекст();	
	КонецЕсли;  
	
	Если ТекущийОбъект.ТипВопроса = Справочники.ТипыВопросов.РучнойВвод И ЗначениеЗаполнено(ЭталонныйОтвет) Тогда
		
		СуществующийОтвет = РаботаСВопросамиВызовСервера.ПолучитьЭталонныйОтвет(ТекущийОбъект.Ссылка);
		
		Если СуществующийОтвет = Справочники.ЭталонныеОтветы.ПустаяСсылка() Тогда
			НовыйОтвет = Справочники.ЭталонныеОтветы.СоздатьЭлемент();
			НовыйОтвет.Заполнить(Неопределено);
			НовыйОтвет.Владелец = ТекущийОбъект.Ссылка;
			НовыйОтвет.Ответ = ЭталонныйОтвет;
			НовыйОтвет.Записать();
		Иначе
			ОтветОбъект = СуществующийОтвет.ПолучитьОбъект();
			ОтветОбъект.Ответ = ЭталонныйОтвет;
			ОтветОбъект.Записать();
		КонецЕсли;
		
	ИначеЕсли ТекущийОбъект.ТипВопроса <> Справочники.ТипыВопросов.РучнойВвод Тогда
		СуществующийОтвет = РаботаСВопросамиВызовСервера.ПолучитьЭталонныйОтвет(ТекущийОбъект.Ссылка);
		Если НЕ СуществующийОтвет = Справочники.ЭталонныеОтветы.ПустаяСсылка() Тогда
			ОтветОбъект = СуществующийОтвет.ПолучитьОбъект();
			ОтветОбъект.ПометкаУдаления = Истина;
			ОтветОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.ТипВопроса.Пустая() Тогда
		Элементы.ВариантыОтветов.Видимость = Ложь;
		Элементы.ЭталонныйОтвет.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 
	
	Если ТекущийОбъект.ТекстВопроса = "" И ТекущийОбъект.Вопрос = Неопределено Тогда
		ТекущийОбъект.ВключатьВТест = Ложь;
	Иначе
		ТекущийОбъект.ВключатьВТест = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере                                                                                                                 
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты) 
	
	ТекущийОбъектСправочника = РеквизитФормыВЗначение("Объект");
	
	Если Объект.ТекстВопроса = "" И ТекущийОбъектСправочника.Вопрос = Неопределено Тогда
		ПроверяемыеРеквизиты.Добавить("ТекстВопроса", "Не заполнен текст вопроса");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.ТипВопроса.Пустая() Тогда
		ПроверяемыеРеквизиты.Добавить("ТипВопроса", "Не выбран тип вопроса");
		Отказ = Истина;
	КонецЕсли;          
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовШапкиФормы 

&НаКлиенте
Процедура ТипВопросаПриИзменении(Элемент)
	
	ТипВопросаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантыОтветовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) 
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(,"Сначала сохраните вопрос");
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
	Отказ = Истина;
	
	ОткрытьФорму("Справочник.ВариантыОтветов.Форма.ФормаЭлемента", Новый Структура("Владелец", Объект.Ссылка), ЭтотОбъект);			
	
	
КонецПроцедуры 

&НаКлиенте
Процедура ЭталонныйОтветСоздание(Элемент, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьПредупреждение(, "Сначала сохраните вопрос");  
		Возврат;	
	КонецЕсли; 
		
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура Сгенерировать(Команда)  
	
	Если ПустаяСтрока(Объект.Блок) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заполните блок по которому хотите составить вопрос";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Объект.ТипВопроса.Пустая() Тогда  
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите тип вопроса";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли; 
	
	ТекущийТекст = "";
	Если Документ <> Неопределено Тогда
		ТекущийТекст = Документ.ПолучитьТекст();
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекущийТекст) Тогда
		ТекстВопроса = НСтр("ru = 'Введенный текст вопроса будет замещен. Учитывать его при генерации?'");
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект, ТекущийТекст);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе    
		Результат = GigaChatРаботаВызовСервера.СгенерироватьВопросБезКонтекста(Объект.Блок, Объект.ТипВопроса);
		ОбработатьРезультатГенерации(Результат);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции 

&НаКлиенте
Процедура ПослеОтветаНаВопрос(РезультатОпроса, ДополнительныеПараметры) Экспорт
	
	ТекущийТекст = ДополнительныеПараметры; 
	
	Если РезультатОпроса = КодВозвратаДиалога.Да Тогда
		НовыйВопрос = GigaChatРаботаВызовСервера.СгенерироватьВопросСКонтекстом(Объект.Блок, Объект.ТипВопроса, ТекущийТекст);
	Иначе
		НовыйВопрос = GigaChatРаботаВызовСервера.СгенерироватьВопросБезКонтекста(Объект.Блок, Объект.ТипВопроса); 
	КонецЕсли;
	
	ОбработатьРезультатГенерации(НовыйВопрос);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатГенерации(Результат)
	
	Если ЗначениеЗаполнено(Результат.Вопрос) Тогда
		Документ = Новый ФорматированныйДокумент;
		Документ.Добавить(Результат.Вопрос);
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ЭтотОбъект.Записать();
	КонецЕсли;  
	
	РаботаСВопросамиВызовСервера.УдалитьОтветы(Объект.Ссылка);
	
	РаботаСВопросамиВызовСервера.СохранитьОтветы(Объект.Ссылка, Результат, Объект.ТипВопроса);
	
	Элементы.ВариантыОтветов.Обновить();
	ЭталонныйОтвет = РаботаСВопросамиВызовСервера.ПолучитьЭталонныйОтвет(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ТипВопросаПриИзмененииНаСервере()
	
	ТекущийТип = Объект.ТипВопроса;
	
	Если ТекущийТип.МножественныеОтветы Тогда
		Элементы.ВариантыОтветов.Видимость = Истина;
		Элементы.ЭталонныйОтвет.Видимость = Ложь;
	Иначе
		Элементы.ВариантыОтветов.Видимость = Ложь;
		Элементы.ЭталонныйОтвет.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВладельцаНаСервере(Ссылка)
	
	ВариантыОтветов.Параметры.УстановитьЗначениеПараметра("Владелец", Ссылка);
	ЭталонныеОтветы.Параметры.УстановитьЗначениеПараметра("Владелец", Ссылка);
	ЭталонныйОтвет = РаботаСВопросамиВызовСервера.ПолучитьЭталонныйОтвет(Ссылка);
	
КонецПроцедуры

#КонецОбласти
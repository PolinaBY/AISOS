#Область ПрограммныйИнтерфейс  

Процедура ПередЗаписью(Отказ)   
	
	Если ОбменДанными.Загрузка Тогда
    	Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина); 
		
	Если Не ДатаУвольнения = Дата('00010101') И ДатаУвольнения <= ТекущаяДатаСеанса()  Тогда
		Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Ссылка);
		
		Если ЗначениеЗаполнено(Пользователь.ИдентификаторПользователяИБ) Тогда
                ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
                    Пользователь.ИдентификаторПользователяИБ);
                Если ПользовательИБ <> Неопределено Тогда
                    ПользовательИБ.АутентификацияСтандартная = Ложь;
                    ПользовательИБ.Записать();
                КонецЕсли;
         КонецЕсли;
            
            НаборЗаписей = РегистрыСведений.СведенияОПользователях.СоздатьНаборЗаписей(); 
			НаборЗаписей.Заполнить(Неопределено);
            НаборЗаписей.Отбор.Пользователь.Установить(Пользователь.Ссылка);
            НаборЗаписей.Прочитать();
            
            Если НаборЗаписей.Количество() = 0 Тогда
                Запись = НаборЗаписей.Добавить(); 
                Запись.Пользователь = Пользователь.Ссылка;
            Иначе
                Запись = НаборЗаписей[0];
            КонецЕсли;
            
            Запись.ВходВПрограммуРазрешен = Ложь;
            Запись.ДатаАвтоматическогоЗапрещенияВхода = ТекущаяДатаСеанса();
            НаборЗаписей.Записать();
			
			ПользовательОбъект = Пользователь.ПолучитьОбъект();
            ПользовательОбъект.Недействителен = Истина;
            ПользовательОбъект.Записать();
            
	КонецЕсли;  

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

#КонецОбласти
 
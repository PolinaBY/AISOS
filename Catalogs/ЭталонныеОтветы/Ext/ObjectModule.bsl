#Область ПрограммныйИнтерфейс   

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
   
       
    ТипДанных = ТипЗнч(ДанныеЗаполнения);
    
    Если ТипДанных = Тип("СправочникСсылка.Вопросы") Тогда
        Владелец = ДанныеЗаполнения;
    ИначеЕсли ТипДанных = Тип("Структура") Тогда
        Если ДанныеЗаполнения.Свойство("Владелец") Тогда
            Владелец = ДанныеЗаполнения.Владелец;
        КонецЕсли;
    КонецЕсли;
    
    Если Владелец <> Неопределено И Не Владелец.Пустая() Тогда
        ЭтотОбъект.Владелец = Владелец; 
	КонецЕсли;      
	
	Если НЕ ПустаяСтрока(ТекстЗаполнения) И ПустаяСтрока(ЭтотОбъект.Ответ) Тогда
        ЭтотОбъект.Ответ = ТекстЗаполнения;
    КонецЕсли;
    
КонецПроцедуры  

#КонецОбласти
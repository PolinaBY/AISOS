#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ)
	
	Если Параметры.Свойство("ВыбранныеТеги") И Параметры.ВыбранныеТеги.Количество() > 0 Тогда
		ВыбранныеТеги = Параметры.ВыбранныеТеги;
		
		СписокСсылок = Новый Массив;
		Для Каждого Элемент Из ВыбранныеТеги Цикл
			СписокСсылок.Добавить(Элемент.Значение);
		КонецЦикла;
		
		Элементы.Список.ВыделенныеСтроки.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Теги КАК Теги
		|ГДЕ
		|	Ссылка В (&СписокСсылок)";
		Запрос.УстановитьПараметр("СписокСсылок", СписокСсылок);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Элементы.Список.ВыделенныеСтроки.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

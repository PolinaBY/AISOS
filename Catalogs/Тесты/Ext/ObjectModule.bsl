#Область ПрограммныйИнтерфейс

Процедура ПриЗаписи(Отказ) 
	
	Если ОбменДанными.Загрузка Тогда
    	Возврат;
	КонецЕсли;
		
	НаборЗаписей = РегистрыСведений.СоставТестовПоБлокам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Тест.Установить(Ссылка);
	НаборЗаписей.Заполнить(Неопределено);
    
	Для Каждого СтрокаБлок Из СоставТеста Цикл  
		
		Если СтрокаБлок.ВключатьВТест = Истина Тогда
        
        	Запись = НаборЗаписей.Добавить();
        	Запись.Тест = Ссылка;         
			Запись.БлокВопросов = СтрокаБлок.БлокВопросов;   
        	Запись.Организация = Организация; 
		
		КонецЕсли;
        
    КонецЦикла;
    
    НаборЗаписей.Записать();

    
КонецПроцедуры  

#КонецОбласти

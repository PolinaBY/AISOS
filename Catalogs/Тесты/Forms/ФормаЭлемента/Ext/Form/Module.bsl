#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)  
	
	Для каждого Строка из Объект.СоставТеста Цикл
		Если Строка.ПроходнойПроцент > 100 Или Строка.ПроходнойПроцент = 0 Тогда
			Отказ = Истина;
			Строка.ПроходнойПроцент = 100;    
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Проходной процент должен находиться в диапазоне от 1 до 100";
			Сообщение.Сообщить();
		КонецЕсли;  
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
        
        Если ЗначениеЗаполнено(ПараметрыСеанса.ТекущаяОрганизация) Тогда
            Объект.Организация = ПараметрыСеанса.ТекущаяОрганизация;
        КонецЕсли;
        
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставТеста   

&НаКлиенте
Процедура СоставТестаБлокВопросовПриИзменении(Элемент)    
	
	ТекущаяСтрока = Элементы.СоставТеста.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ВыбранныйБлок = ТекущаяСтрока.БлокВопросов;
	                                              
	Если ЗначениеЗаполнено(ВыбранныйБлок) Тогда
        КоличествоВопросов = ПолучитьКоличествоВопросовБлока(ВыбранныйБлок);
        ТекущаяСтрока.КоличествоВопросов = КоличествоВопросов;
    Иначе
        ТекущаяСтрока.КоличествоВопросов = 0;
	КонецЕсли;  
	
КонецПроцедуры 

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьКоличествоВопросовБлока(Блок)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	КОЛИЧЕСТВО(Вопросы.Ссылка) КАК Количество
    |ИЗ
    |	Справочник.Вопросы КАК Вопросы
    |ГДЕ
    |	Вопросы.Блок = &Блок
    |	И Вопросы.ВключатьВТест = ИСТИНА
    |	И НЕ Вопросы.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("Блок", Блок);
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выбрать();

    Если Результат.Следующий() Тогда
        Возврат Результат.Количество;
    КонецЕсли;
    
    Возврат 0;
    
КонецФункции

#КонецОбласти


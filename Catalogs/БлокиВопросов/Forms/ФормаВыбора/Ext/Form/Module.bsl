#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборСписокТеговНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыбранныеТеги", СписокТегов);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораТегов", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.Теги.ФормаВыбора", ПараметрыФормы, 
		ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ОтборСписокТеговПриИзменении(Элемент)
	УстановитьОтборПоТегу(СписокТегов);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	МассивБлоков = Новый Массив;
	Для Каждого ТекСтроки Из Строки Цикл
		ТекБлок = ТекСтроки.Значение.Данные.Ссылка;
		МассивБлоков.Добавить(ТекБлок);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БлокиВопросовТеги.Ссылка КАК Блок,
	|	БлокиВопросовТеги.Тег.Наименование КАК ТегНаименование
	|ИЗ
	|	Справочник.БлокиВопросов.Теги КАК БлокиВопросовТеги
	|ГДЕ
	|	БлокиВопросовТеги.Ссылка В (&МассивБлоков)
	|
	|УПОРЯДОЧИТЬ ПО
	|	БлокиВопросовТеги.Ссылка,
	|	ТегНаименование";
	
	Запрос.УстановитьПараметр("МассивБлоков", МассивБлоков);
	Результат = Запрос.Выполнить();
	Выгрузка = Результат.Выгрузить();
	
	Для Каждого ТекСтроки Из Строки Цикл
		ТекБлок = ТекСтроки.Значение.Данные.Ссылка;
		
		СтруктураПоиска = Новый Структура("Блок", ТекБлок);
		НайденныеСтроки = Выгрузка.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТегов = "";
			Для Каждого ТегСтрока Из НайденныеСтроки Цикл
				СтрокаТегов = СтрокаТегов + ?(ПустаяСтрока(СтрокаТегов), "", ", ") + ТегСтрока.ТегНаименование;
			КонецЦикла;
			ТекСтроки.Значение.Данные.ТегиСтрока = СтрокаТегов;

		Иначе
			ТекСтроки.Значение.Данные.ТегиСтрока = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоТегу(СписокТегов)
	
	Список.Отбор.Элементы.Очистить();
	
	Если СписокТегов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТегиПоБлокам.Блок КАК Блок
	|ИЗ
	|	РегистрСведений.ТегиПоБлокам КАК ТегиПоБлокам
	|ГДЕ
	|	ТегиПоБлокам.Тег В (&СписокТегов)
	|СГРУППИРОВАТЬ ПО
	|	ТегиПоБлокам.Блок
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ТегиПоБлокам.Тег) = &КоличествоТегов";
	
	Запрос.УстановитьПараметр("СписокТегов", СписокТегов);
	Запрос.УстановитьПараметр("КоличествоТегов", СписокТегов.Количество());
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	МассивБлоков = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивБлоков.Добавить(Выборка.Блок);
	КонецЦикла;
	
	Если МассивБлоков.Количество() > 0 Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = МассивБлоков;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.Представление = "Теги: " + СобратьСтрокуТегов(СписокТегов);
	Иначе
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Неопределено;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.Представление = "Теги: " + СобратьСтрокуТегов(СписокТегов);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СобратьСтрокуТегов(МассивТегов)
	
	Строка = "";
	Для Каждого Тег Из МассивТегов Цикл
		Строка = Строка + Тег.Наименование + ", ";
	КонецЦикла;
	
	Если Строка <> "" Тогда
		Строка = Лев(Строка, СтрДлина(Строка) - 2);
	КонецЕсли;
	
	Возврат Строка;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораТегов(ВыбранныеТеги, Параметры) Экспорт
	
	Если ВыбранныеТеги = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокТегов.Очистить();
	
	Для Каждого Тег Из ВыбранныеТеги Цикл
		СписокТегов.Добавить(Тег, Тег);
	КонецЦикла;
	
	УстановитьОтборПоТегу(ВыбранныеТеги);
КонецПроцедуры	

#КонецОбласти

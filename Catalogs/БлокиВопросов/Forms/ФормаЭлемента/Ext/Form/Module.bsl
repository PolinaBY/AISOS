#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьТеги();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТегиЗаполнениеНажатие(Элемент)
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Блок", Объект.Ссылка);
		ПараметрыФормы.Вставить("ВыбранныеТеги", ПолучитьМассивТеговИзРегистра());
	
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораТегов", ЭтотОбъект);
		ОткрытьФорму("ОбщаяФорма.ПоискТегов", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);  
	Иначе 
		ТекстВопроса = НСтр("ru = 'Данные еще не записаны. Переход к назначению тегов возможен только после записи днных. Данные будут записаны.'");
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораТегов(ВыбранныеТеги, Параметры) Экспорт
	
	Если ВыбранныеТеги = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗадатьТегиНаСервере(ВыбранныеТеги);
	ЗаполнитьТеги();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивТеговИзРегистра()
	
	Массив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТегиПоБлокам.Тег КАК Тег
	|ИЗ
	|	РегистрСведений.ТегиПоБлокам КАК ТегиПоБлокам
	|ГДЕ
	|	ТегиПоБлокам.Блок = &Блок";
	
	Запрос.УстановитьПараметр("Блок", Объект.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Тег);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТеги()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Блок", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТегиПоБлокам.Тег.Наименование КАК Наименование
	|ИЗ
	|	РегистрСведений.ТегиПоБлокам КАК ТегиПоБлокам
	|ГДЕ
	|	ТегиПоБлокам.Блок = &Блок";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СписокТегов = "";
	Пока Выборка.Следующий() Цикл
		СписокТегов = СписокТегов + Выборка.Наименование + ", ";
	КонецЦикла;
	
	Если СписокТегов = "" Тогда
		Элементы.ТегиЗаполнение.Заголовок = "Теги не заданы";
	Иначе
		СписокТегов = Лев(СписокТегов, СтрДлина(СписокТегов) - 2);
		Элементы.ТегиЗаполнение.Заголовок = "Теги: " + СписокТегов;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗадатьТегиНаСервере(Теги)
	
	НачатьТранзакцию();

    Попытка
		Блок = Объект.Ссылка;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТегиПоБлокам");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Блок", Блок);
		Блокировка.Заблокировать(); 
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Блок", Блок);
		Запрос.УстановитьПараметр("Теги", Теги);
		Запрос.Текст = ПолучитьТекстЗапроса();
		
		УстановитьПривилегированныйРежим(Истина);
		ПакетРезультатовЗапросов = Запрос.ВыполнитьПакет();
		КоличествоПакетов = ПакетРезультатовЗапросов.Количество();
		Выборка = ПакетРезультатовЗапросов[КоличествоПакетов - 1].Выбрать(); 
		Пока Выборка.Следующий() Цикл
			
			МенеджерЗаписи = РегистрыСведений.ТегиПоБлокам.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Заполнить(Неопределено);
			МенеджерЗаписи.Блок = Блок;
			МенеджерЗаписи.Тег = Выборка.Тег;
			МенеджерЗаписи.Записать();
			
			МенеджерЗаписи = РегистрыСведений.ИзмененияТеговПоБлокам.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Заполнить(Неопределено);
			МенеджерЗаписи.Блок = Блок;
			МенеджерЗаписи.Тег = Выборка.Тег;
			МенеджерЗаписи.ДатаИзменения = ТекущаяДатаСеанса();
			МенеджерЗаписи.Записать(); 
			
			
		КонецЦикла;
		
		Выборка = ПакетРезультатовЗапросов[КоличествоПакетов - 2].Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборЗаписей =  РегистрыСведений.ТегиПоБлокам.СоздатьНаборЗаписей();
			НаборЗаписей.Заполнить(Неопределено);
			НаборЗаписей.Отбор.Блок.Установить(Блок);
			НаборЗаписей.Отбор.Тег.Установить(Выборка.Тег);
			НаборЗаписей.Записать();
		КонецЦикла;
		
		Объект.Теги.Очистить();
		
		Для Каждого ТекТег Из Теги Цикл
			НоваяСтрока = Объект.Теги.Добавить();
			НоваяСтрока.Тег = ТекТег;
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);

		ЗаполнитьТеги();
		
		ЗафиксироватьТранзакцию();
	Исключение  
		ОтменитьТранзакцию();   
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
		"Теги.УстановкаТегов",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке) + Символы.ПС +
		"Блок: " + Строка(Блок) + Символы.ПС +
		"Количество тегов: " + Строка(Теги.Количество())
		);
		
		ТекстСообщения = НСтр("ru = 'Не удалось установить теги'") + Символы.ПС +
		ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		ВызватьИсключение(ТекстСообщения, , , , ИнформацияОбОшибке);    
	КонецПопытки;
    
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьТекстЗапроса()
	
	Возврат 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Теги.Ссылка КАК Тег
	|ПОМЕСТИТЬ ВТ_ТаблицаТеги
	|ИЗ
	|	Справочник.Теги КАК Теги
	|ГДЕ
	|	Теги.Ссылка В (&Теги)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТегиПоБлокам.Блок КАК Блок,
	|	ТегиПоБлокам.Тег КАК Тег
	|ИЗ
	|	РегистрСведений.ТегиПоБлокам КАК ТегиПоБлокам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаТеги КАК ВТ_ТаблицаТеги
	|		ПО ТегиПоБлокам.Тег = ВТ_ТаблицаТеги.Тег
	|ГДЕ
	|	ТегиПоБлокам.Блок = &Блок
	|	И ВТ_ТаблицаТеги.Тег ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТеги.Тег КАК Тег
	|ИЗ
	|	ВТ_ТаблицаТеги КАК ВТ_ТаблицаТеги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТегиПоБлокам КАК ТегиПоБлокам
	|		ПО ВТ_ТаблицаТеги.Тег = ТегиПоБлокам.Тег
	|		И ТегиПоБлокам.Блок = &Блок
	|ГДЕ
	|	ТегиПоБлокам.Тег ЕСТЬ NULL";
	
	
КонецФункции

&НаКлиенте
Процедура ПослеОтветаНаВопрос(РезультатОпроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатОпроса = КодВозвратаДиалога.Да Тогда
		Записать(); 
	Иначе
		Возврат; 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
